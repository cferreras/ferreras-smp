---
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import InnerHero from '../components/InnerHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { breadcrumbSchema } from '../lib/schema';
import '../styles/phi.css';

export const prerender = true;

const structuredData = [breadcrumbSchema([{ name: 'Normas' }])];

const rules = [
	{
		icon: 'chat',
		tone: 'violet',
		title: 'Trato y convivencia',
		items: [
			'No se permiten trampas, toxicidad, spam ni faltas de respeto.',
			'Habla con otras personas como te gustaría que hablaran contigo.',
			'Si hay un conflicto, pide ayuda antes de escalarlo en público.',
		],
	},
	{
		icon: 'home',
		tone: 'lime',
		title: 'Construcciones y objetos',
		items: [
			'No robes objetos de las casas de otras personas.',
			'Los objetos abandonados en cofres fuera de casas o en shulkers tiradas sí pueden ser robados. Guarda lo importante en un Ender Chest.',
			'No construyas demasiado cerca de una zona ya construida sin preguntar antes.',
			'Respeta el trabajo, los caminos y el espacio de quienes llegaron antes.',
		],
	},
	{
		icon: 'copy',
		tone: 'amber',
		title: 'Duplicación',
		items: [
			'No se pueden duplicar objetos renovables.',
			'Sí se permite duplicar recursos no renovables, como TNT o arena.',
			'La diferencia depende de si el recurso puede volver a obtenerse de forma natural.',
		],
	},
	{
		icon: 'sword',
		tone: 'violet',
		title: 'PvP',
		items: [
			'Está habilitado técnicamente, pero no es una conducta normal.',
			'Dos miembros pueden acordar pelearse y matarse.',
			'Nadie puede quedarse con los objetos de la otra persona.',
		],
	},
];

// Qué pasa cuando algo sale mal: cada garantía con un título corto para que
// se lean como pasos de la misma red de seguridad.
const safety = [
	{ title: 'Registros', text: 'Usamos Ledger para consultar qué acciones se hicieron y cuándo.' },
	{ title: 'Copias de seguridad', text: 'Hay copias de seguridad del mundo para revertir un destrozo.' },
	{ title: 'Apelación', text: 'El incumplimiento puede provocar una expulsión, y quien la recibe puede apelar: el caso se revisa.' },
];
---

<Layout
	title="Normas — Cubusfera"
	description="Normas de convivencia, construcciones, robos, duplicaciones y PvP de Cubusfera, en cuatro bloques."
	structuredData={structuredData}
>
	<div class="phi">
		<SiteHeader>
			<InnerHero
				chip="Convivencia"
				title="Construimos juntos."
				highlight="Respetamos el espacio."
				lead="Las normas no están para llenar una página: están para que el trabajo de una persona siga siendo suyo y el mundo compartido se mantenga agradable con el tiempo."
			/>
		</SiteHeader>

		<main>
			<section class="container home-section" aria-labelledby="bloques">
				<div class="home-head">
					<div class="home-head-title">
						<span class="home-kicker">01 — Las normas</span>
						<h2 id="bloques">Cuatro bloques, nada más.</h2>
					</div>
					<p class="home-lead">Si dudas sobre una situación concreta, pregunta antes de actuar. El contexto importa más que encontrar un hueco en la redacción.</p>
				</div>

				<div class="rule-grid">
					{rules.map((rule) => (
						<article class="home-card">
							<div class={`home-card-icon home-card-icon-${rule.tone}`}>
								{rule.icon === 'chat' && (
									<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12.5a7 7 0 0 1-7 7H8l-4 2.5.9-3.4A7 7 0 0 1 11 4.5h2a7 7 0 0 1 7 7z" /></svg>
								)}
								{rule.icon === 'home' && (
									<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 10.5 12 3.5l8.5 7" /><path d="M5.5 9.5v10h13v-10" /><path d="M9.75 19.5v-5.5h4.5v5.5" /></svg>
								)}
								{rule.icon === 'copy' && (
									<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="3" /><path d="M6 15H4.5A1.5 1.5 0 0 1 3 13.5v-9A1.5 1.5 0 0 1 4.5 3h9A1.5 1.5 0 0 1 15 4.5V6" /></svg>
								)}
								{rule.icon === 'sword' && (
									<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 3.5v4l-9 9-4-4 9-9z" /><path d="M7.5 12.5 4 16l4 4 3.5-3.5" /><path d="M3.5 20.5 6 18" /></svg>
								)}
							</div>
							<h3>{rule.title}</h3>
							<ul class="rule-list">
								{rule.items.map((item) => <li>{item}</li>)}
							</ul>
						</article>
					))}
				</div>
			</section>

			<section class="home-band home-band-lime" aria-labelledby="si-sale-mal">
				<div class="container">
					<div class="home-head">
						<div class="home-head-title">
							<span class="home-kicker">02 — Incidencias</span>
							<h2 id="si-sale-mal">Si algo sale mal.</h2>
						</div>
						<p class="home-lead">Podemos comprobar lo que pasó antes de decidir nada, y una expulsión no es el final de la conversación.</p>
					</div>

					<ol class="home-steps">
						{safety.map((item, index) => (
							<li class="home-step">
								<span class="home-step-number">{String(index + 1).padStart(2, '0')}</span>
								<strong class="home-step-title">{item.title}</strong>
								<p>{item.text}</p>
							</li>
						))}
					</ol>
				</div>
			</section>

			<CtaBand
				title="¿Todo claro? Nos vemos en Discord."
				lead="Ahí se resuelven las dudas y se abre la whitelist."
				secondary={{ href: '/como-entrar/', label: 'Ver cómo entrar' }}
			/>
		</main>

		<SiteFooter />
	</div>
</Layout>
