---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Rules from "../components/Rules.astro";
import Mods from "../components/Mods.astro";
import Join from "../components/Join.astro";
import Footer from "../components/Footer.astro";
import { server } from "../data/server";
---

<Layout
  title={`${server.name} — Servidor de supervivencia`}
  description={`${server.name} es un servidor de Minecraft de supervivencia sin mods requeridos. Conecta en ${server.address}.`}
>
  <Header />
  <main>
    <Hero />
    <About />
    <Rules />
    <Mods />
    <Join />
  </main>
  <Footer />
</Layout>
