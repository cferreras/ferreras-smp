---
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import DiscordIcon from '../components/DiscordIcon.astro';

const discordUrl = 'https://discord.com/invite/xW7yyHRJvE';
export const prerender = true;

const claims = [
	{
		icon: 'cube',
		tone: 'violet',
		title: 'Vanilla de verdad',
		text: 'Nada de economía, rangos ni tiendas. El Minecraft que ya conoces, con <a href="/servidor/">granjas técnicas y proyectos libres</a>.',
	},
	{
		icon: 'bolt',
		tone: 'lime',
		title: 'Entras y juegas',
		text: 'No instalas nada. Fabric corre en el servidor, no en tu ordenador: abres el juego y te conectas.',
	},
	{
		icon: 'people',
		tone: 'amber',
		title: 'Como mucho, 20',
		text: 'Una comunidad pequeña, mayor de 16 años. Leemos cada solicitud a mano y respondemos por Discord.',
	},
];

const steps = [
	{
		title: 'Entra en Discord',
		text: 'El punto de encuentro. Presentamos el servidor y resolvemos dudas sin compromiso.',
	},
	{
		title: 'Rellena el formulario',
		text: 'Tu edad, qué buscas y cómo te gusta jugar. No es un examen: es contexto.',
	},
	{
		title: 'Hablamos y entras',
		text: 'Revisamos cada solicitud a mano. Si encaja, te añadimos a la whitelist el mismo día.',
	},
];

const world = [
	{
		image: '/images/gallery/casas-frente-al-mar.jpg',
		alt: 'Dos casas de madera y piedra frente al mar',
		caption: 'Casas frente al mar y granja de hierro',
	},
	{
		image: '/images/gallery/casa-entre-bambus.jpg',
		alt: 'Casa de ladrillo cubierta de vegetación junto a un bambusal',
		caption: 'Trading hall para aldeanos',
	},
	{
		image: '/images/gallery/veronicucha-fortaleza.jpg',
		alt: 'Una jugadora sobre la torre de una fortaleza de piedra',
		caption: 'Ciudad en construcción',
	},
];

const posts = [
	{ category: 'Servidor', title: 'Qué mods hay en Cubusfera', href: '/blog/que-mods-hay-ferreras-smp/' },
	{ category: 'Guía', title: 'Qué es un servidor SMP', href: '/blog/que-es-servidor-smp-minecraft/' },
	{ category: 'Cómo entrar', title: 'Cómo entrar a Minecraft Java', href: '/blog/como-entrar-servidor-minecraft-java/' },
];

// La home describe el propio servidor como producto: el WebSite y la
// Organization ya los aporta el layout, aquí va la ficha del juego.
const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		'@id': 'https://mc.ferreras.dev/#webpage',
		url: 'https://mc.ferreras.dev/',
		name: 'Cubusfera — Minecraft Vanilla técnico, hecho en comunidad',
		description:
			'Servidor de Minecraft Java 26.2 vanilla técnico con Fabric del lado del servidor, whitelist con revisión manual y un máximo de 20 jugadores.',
		inLanguage: 'es-ES',
		isPartOf: { '@id': 'https://mc.ferreras.dev/#website' },
		about: { '@id': 'https://mc.ferreras.dev/#organization' },
		primaryImageOfPage: {
			'@type': 'ImageObject',
			url: 'https://mc.ferreras.dev/images/gallery/ferreritas-costa-atardecer.jpg',
		},
	},
];
---

<Layout
	title="Cubusfera — Minecraft Vanilla técnico, hecho en comunidad"
	description="Cubusfera es un servidor Minecraft Java 26.2, Vanilla técnico y comunitario. Una microcomunidad pequeña, sin Pay2Win y sin modpack obligatorio."
	structuredData={structuredData}
>
	<SiteHeader>
		<div class="container hero" id="inicio">
			<div class="hero-copy">
				<span class="chip"><span class="chip-dot" aria-hidden="true"></span> Java 26.2 · Whitelist abierta</span>

				<h1>Minecraft vanilla, hecho <span>en comunidad.</span></h1>

				<p class="hero-lead">Un mundo pequeño para construir sin prisas. Sin Pay2Win, sin economía y sin modpack obligatorio.</p>

				<div class="hero-actions">
					<a class="button button-on-violet" href={discordUrl} target="_blank" rel="noopener noreferrer"><DiscordIcon /> <span>Entrar en Discord</span></a>
					<a class="button-ghost button-ghost-on-violet" href="/como-entrar/">Cómo entrar</a>
				</div>

				<p class="hero-status" data-server-status="hero" data-status-state="loading" role="status">
					<span class="status-dot" aria-hidden="true"></span>
					<span data-server-status-text>Comprobando servidor…</span>
				</p>
			</div>

			<figure class="hero-visual">
				<img src="/images/gallery/ferreritas-costa-atardecer.jpg" alt="Vista del mundo de Cubusfera al atardecer, con casas junto a la costa" width="1200" height="800" fetchpriority="high" />
			</figure>
		</div>
	</SiteHeader>

	<main>
		<section class="section" id="servidor">
			<div class="container">
				<h2 class="section-title">Esto es lo que hay. Y lo que no.</h2>
				<p class="section-intro">Preferimos contarlo antes de que entres, para que no pierdas el tiempo si buscas otra cosa.</p>

				<div class="claims">
					{claims.map((claim) => (
						<article class="card">
							<div class={`card-icon card-icon-${claim.tone}`}>
								{claim.icon === 'cube' && (
									<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.6 20.5 7v10L12 21.4 3.5 17V7z" /><path d="M3.5 7 12 11.6 20.5 7" /><path d="M12 11.6V21.4" /></svg>
								)}
								{claim.icon === 'bolt' && (
									<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2 4.5 13.5H11l-1 8.5 9-11.5h-6.5z" /></svg>
								)}
								{claim.icon === 'people' && (
									<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.2" /><path d="M2.8 20c0-3.4 2.8-5.6 6.2-5.6s6.2 2.2 6.2 5.6" /><path d="M16.4 5.2a3.2 3.2 0 0 1 0 6" /><path d="M18 14.8c2 .7 3.2 2.5 3.2 5.2" /></svg>
								)}
							</div>
							<h3>{claim.title}</h3>
							<p set:html={claim.text}></p>
						</article>
					))}
				</div>

				<p class="no-fit">
					<span class="no-fit-label">Seguramente no encajes si…</span>
					<span>buscas un servidor grande</span>
					<span>quieres plugins y economía</span>
					<span>vienes a probar y ya</span>
				</p>
			</div>
		</section>

		<section class="band band-lime" id="como-entrar">
			<div class="container">
				<div class="section-head-split">
					<div>
						<h2 class="section-title">Entrar cuesta tres pasos.</h2>
						<p class="band-lead">Todo pasa en Discord. Ahí ves cómo hablamos antes de decidir nada.</p>
					</div>
					<a class="button button-on-lime" href={discordUrl} target="_blank" rel="noopener noreferrer"><DiscordIcon /> <span>Entrar en Discord</span></a>
				</div>

				<ol class="steps">
					{steps.map((step, index) => (
						<li class="step">
							<span class="step-number">{String(index + 1).padStart(2, '0')}</span>
							<strong class="step-title">{step.title}</strong>
							<p class="step-description">{step.text}</p>
						</li>
					))}
				</ol>

				<div class="ip-panel">
					<div>
						<p class="ip-label">IP del servidor</p>
						<p class="ip-value" data-server-address>play.cubusfera.com</p>
					</div>
					<p class="ip-note">Pégala en «Multijugador → Añadir servidor». Solo conecta si ya estás en la whitelist.</p>
					<button class="copy-ip" type="button" data-copy-ip="play.cubusfera.com">
						<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="3" /><path d="M6 15H4.5A1.5 1.5 0 0 1 3 13.5v-9A1.5 1.5 0 0 1 4.5 3h9A1.5 1.5 0 0 1 15 4.5V6" /></svg>
						<span data-copy-label>Copiar</span>
					</button>
				</div>
			</div>
		</section>

		<section class="section" id="mundo">
			<div class="container">
				<div class="section-head-split">
					<h2 class="section-title">Así se ve el mundo ahora mismo.</h2>
					<p class="section-links">
						<a href="/galeria/">Ver la galería →</a>
						<a href="/bluemap/">Abrir el mapa →</a>
					</p>
				</div>

				<div class="world-grid">
					{world.map((shot) => (
						<figure>
							<img src={shot.image} alt={shot.alt} width="1200" height="800" loading="lazy" />
							<figcaption>{shot.caption}</figcaption>
						</figure>
					))}
				</div>

				<ul class="blog-row">
					{posts.map((post) => (
						<li>
							<a href={post.href}>
								<span class="blog-row-meta">{post.category}</span>
								<span class="blog-row-title">{post.title}</span>
							</a>
						</li>
					))}
				</ul>
			</div>
		</section>

		<section class="band band-amber">
			<div class="container">
				<h2 class="section-title">¿Te encaja? Nos vemos dentro.</h2>
				<p class="band-lead">La whitelist se abre desde Discord y te contesta una persona, no un bot.</p>
				<div class="band-actions">
					<a class="button button-on-amber" href={discordUrl} target="_blank" rel="noopener noreferrer"><DiscordIcon /> <span>Entrar en Discord</span></a>
					<a class="button-ghost button-ghost-on-amber" href="/normas/">Leer las normas</a>
				</div>
			</div>
		</section>
	</main>

	<SiteFooter />
	<script is:inline src="/server-status.js"></script>
	<script is:inline src="/copy-ip.js"></script>
</Layout>
