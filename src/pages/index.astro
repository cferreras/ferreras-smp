---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import DiscordIcon from '../components/DiscordIcon.astro';
import CtaBand from '../components/CtaBand.astro';
import { formatDate, slugify } from '../lib/blog';
import { heroShots } from '../lib/gallery';
import '../styles/phi.css';

const discordUrl = 'https://discord.com/invite/xW7yyHRJvE';
export const prerender = true;

const claims = [
	{
		icon: 'cube',
		tone: 'violet',
		title: 'Vanilla de verdad',
		text: 'Nada de economía, rangos ni tiendas. El Minecraft que ya conoces, con <a href="/servidor/">granjas técnicas y proyectos libres</a>.',
	},
	{
		icon: 'bolt',
		tone: 'lime',
		title: 'Entras y juegas',
		text: 'No instalas nada. Fabric corre en el servidor, no en tu ordenador: abres el juego y te conectas.',
	},
	{
		icon: 'people',
		tone: 'amber',
		title: 'Como mucho, 20',
		text: 'Una comunidad pequeña, mayor de 16 años. Leemos cada solicitud a mano y respondemos por Discord.',
	},
];

const noFit = ['buscas un servidor grande', 'quieres plugins y economía', 'vienes a probar y ya'];

const steps = [
	{
		title: 'Entra en Discord',
		text: 'El punto de encuentro. Presentamos el servidor y resolvemos dudas sin compromiso.',
	},
	{
		title: 'Rellena el formulario',
		text: 'Tu edad, qué buscas y cómo te gusta jugar. No es un examen: es contexto.',
	},
	{
		title: 'Hablamos y entras',
		text: 'Revisamos cada solicitud a mano. Si encaja, te añadimos a la whitelist el mismo día.',
	},
];

// La primera captura ocupa el rectángulo áureo grande del mosaico; las otras
// dos se apilan en la columna estrecha. Ninguna repite las del carrusel del hero.
const [mainShot, ...sideShots] = [
	{
		image: '/images/gallery/casas-frente-al-mar.jpg',
		alt: 'Dos casas de madera y piedra frente al mar',
		caption: 'Casas frente al mar y granja de hierro',
	},
	{
		image: '/images/gallery/casa-entre-bambus.jpg',
		alt: 'Casa de ladrillo cubierta de vegetación junto a un bambusal',
		caption: 'Trading hall para aldeanos',
	},
	{
		image: '/images/gallery/veronicucha-bosque.jpg',
		alt: 'Veronicucha junto a un árbol en un bosque con caminos de tierra',
		caption: 'Un rincón entre los árboles',
	},
];

// Las tres entradas más recientes: el bloque se actualiza solo al publicar.
const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
	.slice(0, 3)
	.map(({ id, data }) => ({
		href: `/blog/${id}/`,
		title: data.title,
		image: data.image,
		imageAlt: data.imageAlt,
		category: data.category,
		tag: slugify(data.category),
		date: data.publishedAt,
	}));

// La home describe el propio servidor como producto: el WebSite y la
// Organization ya los aporta el layout, aquí va la ficha del juego.
const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		'@id': 'https://cubusfera.com/#webpage',
		url: 'https://cubusfera.com/',
		name: 'Cubusfera — Minecraft Vanilla técnico, hecho en comunidad',
		description:
			'Servidor de Minecraft Java 26.2 vanilla técnico con Fabric del lado del servidor, whitelist con revisión manual y un máximo de 20 jugadores.',
		inLanguage: 'es-ES',
		isPartOf: { '@id': 'https://cubusfera.com/#website' },
		about: { '@id': 'https://cubusfera.com/#organization' },
		primaryImageOfPage: {
			'@type': 'ImageObject',
			url: 'https://cubusfera.com/images/gallery/ferreritas-costa-atardecer.jpg',
		},
	},
];
---

<Layout
	title="Cubusfera — Minecraft Vanilla técnico, hecho en comunidad"
	description="Cubusfera es un servidor Minecraft Java 26.2, Vanilla técnico y comunitario. Una microcomunidad pequeña, sin Pay2Win y sin modpack obligatorio."
	structuredData={structuredData}
>
	<div class="phi">
		<SiteHeader>
			<div class="container home-hero" id="inicio">
				<div class="home-hero-copy">
					<span class="home-chip"><span class="home-chip-dot" aria-hidden="true"></span> Java 26.2 · Whitelist abierta</span>

					<h1>Minecraft vanilla, hecho <span>en comunidad.</span></h1>

					<p class="home-hero-lead">Un mundo pequeño para construir sin prisas. Sin Pay2Win, sin economía y sin modpack obligatorio.</p>

					<div class="home-hero-actions">
						<a class="button button-on-violet" href={discordUrl} target="_blank" rel="noopener noreferrer"><DiscordIcon /> <span>Entrar en Discord</span></a>
						<a class="button-ghost button-ghost-on-violet" href="/como-entrar/">Cómo entrar</a>
					</div>

					<p class="hero-status" data-server-status="hero" data-status-state="loading" role="status">
						<span class="status-dot" aria-hidden="true"></span>
						<span data-server-status-text>Comprobando servidor…</span>
					</p>
				</div>

				{/* Carrusel de capturas: fundido lento cada 6 s, con pausa. Sin JavaScript
				    se ve solo la primera; el resto se descarga cuando la página ya ha
				    cargado (data-src) para no competir con ella. */}
				<div class="home-hero-visual hero-slides" data-hero-slides role="group" aria-roledescription="carrusel" aria-label="Capturas reales del mundo">
					{heroShots.map((shot, index) => (
						<figure class="hero-slide" data-slide aria-roledescription="diapositiva" aria-label={`${index + 1} de ${heroShots.length}`} aria-hidden={index === 0 ? undefined : 'true'} data-active={index === 0 ? '' : undefined}>
							{index === 0 ? (
								<img src={shot.src} alt={shot.alt} width={shot.width} height={shot.height} fetchpriority="high" style={`object-position: ${shot.hero?.position}`} />
							) : (
								<img data-src={shot.src} alt={shot.alt} width={shot.width} height={shot.height} decoding="async" style={`object-position: ${shot.hero?.position}`} />
							)}
							<figcaption class="home-caption">{shot.caption.replace(/\.$/, '')}</figcaption>
						</figure>
					))}
					<div class="hero-slides-controls" data-slides-controls hidden>
						<button class="hero-slides-pause" type="button" data-slides-pause aria-label="Pausar las capturas">
							<svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6v12M15 6v12" /></svg>
							<svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" /></svg>
						</button>
						{heroShots.map((_, index) => (
							<button class="hero-slides-dot" type="button" data-slide-to={index} aria-label={`Ver captura ${index + 1} de ${heroShots.length}`} aria-current={index === 0 ? 'true' : undefined}></button>
						))}
					</div>
				</div>
			</div>
		</SiteHeader>

		<main>
			<section class="home-section" id="servidor">
				<div class="container">
					<div class="home-head">
						<div class="home-head-title">
							<span class="home-kicker">01 — El servidor</span>
							<h2>Esto es lo que hay. Y lo que no.</h2>
						</div>
						<p class="home-lead">Preferimos contarlo antes de que entres, para que no pierdas el tiempo si buscas otra cosa.</p>
					</div>

					<div class="home-claims">
						{claims.map((claim) => (
							<article class="home-card">
								<div class={`home-card-icon home-card-icon-${claim.tone}`}>
									{claim.icon === 'cube' && (
										<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.6 20.5 7v10L12 21.4 3.5 17V7z" /><path d="M3.5 7 12 11.6 20.5 7" /><path d="M12 11.6V21.4" /></svg>
									)}
									{claim.icon === 'bolt' && (
										<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2 4.5 13.5H11l-1 8.5 9-11.5h-6.5z" /></svg>
									)}
									{claim.icon === 'people' && (
										<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.2" /><path d="M2.8 20c0-3.4 2.8-5.6 6.2-5.6s6.2 2.2 6.2 5.6" /><path d="M16.4 5.2a3.2 3.2 0 0 1 0 6" /><path d="M18 14.8c2 .7 3.2 2.5 3.2 5.2" /></svg>
									)}
								</div>
								<h3>{claim.title}</h3>
								<p set:html={claim.text}></p>
							</article>
						))}
					</div>

					<div class="home-no-fit">
						<p class="home-no-fit-label">Seguramente no encajes si…</p>
						<ul>
							{noFit.map((reason) => (
								<li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7 7 17" /></svg>{reason}</li>
							))}
						</ul>
					</div>
				</div>
			</section>

			<section class="home-band home-band-lime" id="como-entrar">
				<div class="container">
					<div class="home-head">
						<div class="home-head-title">
							<span class="home-kicker">02 — Cómo entrar</span>
							<h2>Entrar cuesta tres pasos.</h2>
							<p class="home-lead">Todo pasa en Discord. Ahí ves cómo hablamos antes de decidir nada.</p>
						</div>
						<a class="button button-on-lime home-head-action" href={discordUrl} target="_blank" rel="noopener noreferrer"><DiscordIcon /> <span>Entrar en Discord</span></a>
					</div>

					<ol class="home-steps">
						{steps.map((step, index) => (
							<li class="home-step">
								<span class="home-step-number">{String(index + 1).padStart(2, '0')}</span>
								<strong class="home-step-title">{step.title}</strong>
								<p>{step.text}</p>
							</li>
						))}
					</ol>

					<div class="home-ip">
						<div class="home-ip-address">
							<p class="home-kicker">IP del servidor</p>
							<p class="home-ip-value" data-server-address>play.cubusfera.com</p>
						</div>
						<p class="home-ip-note">Pégala en «Multijugador → Añadir servidor». Solo conecta si ya estás en la whitelist.</p>
						<button class="copy-ip" type="button" data-copy-ip="play.cubusfera.com">
							<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="3" /><path d="M6 15H4.5A1.5 1.5 0 0 1 3 13.5v-9A1.5 1.5 0 0 1 4.5 3h9A1.5 1.5 0 0 1 15 4.5V6" /></svg>
							<span data-copy-label>Copiar IP</span>
						</button>
					</div>
				</div>
			</section>

			<section class="home-section" id="mundo">
				<div class="container">
					<div class="home-head">
						<div class="home-head-title">
							<span class="home-kicker">03 — El mundo</span>
							<h2>Así se ve el mundo ahora mismo.</h2>
						</div>
						<p class="home-links">
							<a href="/galeria/">Ver la galería →</a>
							<a href="/bluemap/">Abrir el mapa →</a>
						</p>
					</div>

					<div class="home-mosaic">
						<figure class="home-mosaic-main">
							<img src={mainShot.image} alt={mainShot.alt} width="1200" height="800" loading="lazy" />
							<figcaption class="home-caption">{mainShot.caption}</figcaption>
						</figure>
						<div class="home-mosaic-side">
							{sideShots.map((shot) => (
								<figure>
									<img src={shot.image} alt={shot.alt} width="1200" height="800" loading="lazy" />
									<figcaption class="home-caption">{shot.caption}</figcaption>
								</figure>
							))}
						</div>
					</div>

					<div class="home-blog">
						<h3 class="home-kicker">Del blog</h3>
						<ul>
							{posts.map((post) => (
								<li data-tag={post.tag}>
									<a href={post.href}>
										<img class="home-blog-thumb" src={post.image} alt={post.imageAlt} width="1200" height="800" loading="lazy" />
										<span class="home-blog-body">
											<span class="home-blog-meta">
												<span class="home-blog-dot" aria-hidden="true"></span>
												{post.category} · <time datetime={post.date.toISOString().slice(0, 10)}>{formatDate(post.date)}</time>
											</span>
											<span class="home-blog-title">{post.title}</span>
										</span>
										<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
									</a>
								</li>
							))}
						</ul>
					</div>
				</div>
			</section>

			<CtaBand
				kicker="04 — Siguiente paso"
				title="¿Te encaja? Nos vemos dentro."
				lead="La whitelist se abre desde Discord y te contesta una persona, no un bot."
				secondary={{ href: '/normas/', label: 'Leer las normas' }}
			/>
		</main>

		<SiteFooter />
	</div>
	<script is:inline src="/server-status.js"></script>
	<script is:inline src="/copy-ip.js"></script>
	<script is:inline src="/hero-slides.js"></script>
</Layout>
