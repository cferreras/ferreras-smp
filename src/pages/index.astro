---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import DiscordIcon from '../components/DiscordIcon.astro';
import YouTubeIcon from '../components/YouTubeIcon.astro';
import CtaBand from '../components/CtaBand.astro';
import HomeCommunity from '../components/HomeCommunity.astro';
import MembersTeaser from '../components/MembersTeaser.astro';
import { formatDate, slugify } from '../lib/blog';
import '../styles/phi.css';

const discordUrl = 'https://discord.com/invite/xW7yyHRJvE';
export const prerender = true;

// La frase que se va marcando al hacer scroll, palabra a palabra.
const revealWords =
	'Somos Cubusfera, un survival de Minecraft Java pequeño y en español. Vanilla de verdad, sin Pay2Win ni economía, para construir sin prisas en un mundo pensado para durar.'.split(' ');

const stats = [
	{ value: '26.3', label: 'versión de Minecraft Java' },
	{ value: '20', label: 'jugadores como máximo' },
	{ value: '0', label: 'mods que instalar' },
	{ value: '16', label: 'años, la edad mínima' },
];

const noFit = ['buscas un servidor grande', 'quieres plugins y economía', 'vienes a probar y ya'];

// La primera captura ocupa el rectángulo áureo grande del mosaico, las dos
// siguientes se apilan en la columna estrecha y las tres últimas van en fila.
const [mainShot, ...restShots] = [
	{
		image: '/images/mundo/ciudad-semaforos.webp',
		alt: 'Calles de ladrillo con semáforos, pasos de cebra y un puente',
		caption: 'Una ciudad con sus calles y semáforos',
		width: 1600,
		height: 900,
	},
	{
		image: '/images/mundo/trading-hall-aldeanos.webp',
		alt: 'Aldeanos en fila, cada uno en su puesto de trabajo',
		caption: 'Trading hall para aldeanos',
		width: 1600,
		height: 900,
	},
	{
		image: '/images/mundo/chiringuito-playa.webp',
		alt: 'Jugador sentado en un banco junto a un chiringuito de madera en la playa',
		caption: 'Un chiringuito en la playa',
		width: 1600,
		height: 900,
	},
	{
		image: '/images/mundo/granja-aldea-sabana.webp',
		alt: 'Jugador con armadura de diamante frente a una granja automática junto a una aldea',
		caption: 'Una granja junto a la aldea',
		width: 1600,
		height: 856,
	},
	{
		image: '/images/mundo/redstone-desde-arriba.webp',
		alt: 'Vista desde arriba de una máquina de redstone con cofres y tolvas',
		caption: 'Redstone vista desde arriba',
		width: 1600,
		height: 856,
	},
	{
		image: '/images/mundo/granja-shulkers-end.webp',
		alt: 'Granja de shulkers de varias plantas sobre el vacío del End',
		caption: 'Granja de shulkers',
		width: 1600,
		height: 856,
	},
];
const sideShots = restShots.slice(0, 2);
const rowShots = restShots.slice(2);

const video = {
	title: 'Un servidor donde mandan las granjas',
	author: 'Opinacraft',
	url: 'https://www.youtube.com/shorts/_y24WEr57Vc',
	channelUrl: 'https://www.youtube.com/@Opinacraft',
	embedUrl: 'https://www.youtube-nocookie.com/embed/_y24WEr57Vc?autoplay=1&rel=0&playsinline=1',
	poster: '/images/video-opinacraft.webp',
};

// Las tres entradas más recientes: el bloque se actualiza solo al publicar.
const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
	.slice(0, 3)
	.map(({ id, data }) => ({
		href: `/blog/${id}/`,
		title: data.title,
		image: data.image,
		imageAlt: data.imageAlt,
		category: data.category,
		tag: slugify(data.category),
		date: data.publishedAt,
	}));

// La home describe el propio servidor como producto: el WebSite y la
// Organization ya los aporta el layout, aquí va la ficha del juego.
const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		'@id': 'https://cubusfera.com/#webpage',
		url: 'https://cubusfera.com/',
		name: 'Cubusfera — Servidor de Minecraft survival vanilla en español',
		description:
			'Servidor de Minecraft Java 26.3 survival en español, vanilla técnico: entras con el cliente vanilla y los mods de Fabric corren solo en el servidor, cuentas premium y no premium, whitelist con revisión manual y un máximo de 20 jugadores.',
		inLanguage: 'es-ES',
		isPartOf: { '@id': 'https://cubusfera.com/#website' },
		about: { '@id': 'https://cubusfera.com/#organization' },
		primaryImageOfPage: {
			'@type': 'ImageObject',
			url: 'https://cubusfera.com/images/hero-redstone-bloques-de-nota.webp',
		},
	},
];
---

<Layout
	title="Cubusfera — Servidor de Minecraft survival vanilla en español"
	description="Servidor de Minecraft Java survival en español, vanilla técnico y sin Pay2Win. Premium o no premium, sin instalar mods y con whitelist."
	structuredData={structuredData}
>
	<div class="phi">
		<SiteHeader variant="video">
			<img class="home-hero-image" src="/images/hero-redstone-bloques-de-nota.webp" alt="" width="2000" height="1070" fetchpriority="high" decoding="async" />

			<div class="container home-hero" id="inicio">
				<div class="home-hero-copy">
					<h1>Minecraft survival, hecho <span>en comunidad.</span></h1>

					<p class="home-hero-lead">Un survival pequeño y en español para construir sin prisas. Sin Pay2Win, sin economía y sin instalar nada.</p>

					<div class="home-hero-actions">
						<a class="button button-on-brand" href={discordUrl} target="_blank" rel="noopener noreferrer"><DiscordIcon /> <span>Entrar en Discord</span></a>
						<a class="button-ghost button-ghost-on-brand" href="/como-entrar/">Cómo entrar</a>
					</div>
				</div>

				<div class="home-hero-aside">
					<p class="hero-status" data-server-status="hero" data-status-state="loading" role="status">
						<span class="status-dot" aria-hidden="true"></span>
						<span data-server-status-text>Comprobando servidor…</span>
					</p>
				</div>
			</div>
		</SiteHeader>

		{/* La hoja de contenido sube por encima del hero, que se queda pegado. */}
		<div class="home-sheet">
			<main>
				<section class="home-intro" aria-label="Qué es Cubusfera">
					<div class="container">
						{/* Sin JavaScript o con movimiento reducido se lee entera desde el
						    principio: scroll-reveal.js apaga las palabras al arrancar. */}
						<p class="home-reveal" data-reveal>
							{revealWords.map((word) => <><span data-word>{word}</span>{' '}</>)}
						</p>

						<dl class="home-stats">
							{stats.map((stat) => (
								<div class="home-stat">
									<dt>{stat.label}</dt>
									<dd>{stat.value}</dd>
								</div>
							))}
						</dl>
					</div>
				</section>

				<section class="home-section home-section-tight" id="servidor">
					<div class="container">
						<div class="home-head">
							<h2>Esto es lo que hay. Y lo que no.</h2>
							<p class="home-lead">Preferimos contarlo antes de que entres, para que no pierdas el tiempo si buscas otra cosa.</p>
						</div>

						<div class="home-bento">
							<article class="home-tile home-tile-lead">
								<h3>Vanilla de verdad</h3>
								<p>Nada de economía, rangos ni tiendas. El Minecraft que ya conoces, con <a href="/servidor/">granjas técnicas y proyectos libres</a>.</p>
								<ul class="home-chips">
									<li>Sin economía</li>
									<li>Sin rangos</li>
									<li>Granjas técnicas</li>
									<li>Proyectos libres</li>
								</ul>
							</article>

							<div class="home-bento-side">
								<article class="home-tile home-tile-brand">
									<h3>Entras y juegas</h3>
									<p>Te conectas con Minecraft Java vanilla, tal cual sale del launcher. Los mods están en el servidor, no en tu juego, y vale cuenta premium o <a href="/blog/servidor-minecraft-no-premium/">no premium</a>.</p>
									<ul class="home-chips">
										<li>Cliente vanilla</li>
										<li>Premium</li>
										<li>No premium</li>
									</ul>
								</article>

								<article class="home-tile">
									<h3>Como mucho, 20</h3>
									<p>Una comunidad pequeña, mayor de 16 años. Leemos cada solicitud a mano y respondemos por Discord.</p>
									<ul class="home-chips">
										<li>+16 años</li>
										<li>Revisión a mano</li>
									</ul>
								</article>
							</div>

							<div class="home-tile home-tile-dark home-no-fit">
								<p class="home-no-fit-label">Seguramente no encajas si…</p>
								<ul class="home-chips">
									{noFit.map((reason) => (
										<li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7 7 17" /></svg>{reason}</li>
									))}
								</ul>
							</div>
						</div>
					</div>
				</section>

				{/* Mientras llega la lista, la misma tarjeta con 20 casillas vacías para
				    que la página no salte. */}
				<MembersTeaser server:defer>
					<HomeCommunity slot="fallback">
						<div class="home-tile home-members" aria-hidden="true">
							<div class="home-members-summary">
								<p class="home-members-count"><strong>–</strong><span>/20</span></p>
								<p class="home-members-label">Comprobando plazas…</p>
								<a class="button" href="/comunidad/" tabindex="-1">Ver la comunidad</a>
							</div>
							<ul class="home-members-heads">
								{Array.from({ length: 20 }, () => <li class="home-members-head is-loading"></li>)}
							</ul>
						</div>
					</HomeCommunity>
				</MembersTeaser>

				<section class="home-band home-band-brand" id="como-entrar">
					<div class="container">
						<div class="home-head">
							<h2>Entrar cuesta <span>tres pasos.</span></h2>
							<p class="home-lead">Todo pasa en Discord. Ahí ves cómo hablamos antes de decidir nada.</p>
						</div>

						{/* Sin números: el raíl de iconos marca el orden (Discord, formulario,
						    charla) y termina en el visto bueno. */}
						<ol class="home-path">
							<li class="home-path-step">
								<span class="home-path-rail" aria-hidden="true">
									<span class="home-path-icon"><DiscordIcon /></span>
									<span class="home-path-line"></span>
								</span>
								<div class="home-path-card">
									<h3>Entra en Discord</h3>
									<p>El punto de encuentro. Presentamos el servidor y resolvemos dudas sin compromiso.</p>
									<a class="button button-on-path" href={discordUrl} target="_blank" rel="noopener noreferrer"><DiscordIcon /> <span>Entrar en Discord</span></a>
								</div>
							</li>
							<li class="home-path-step">
								<span class="home-path-rail" aria-hidden="true">
									<span class="home-path-icon"><svg viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="17" rx="2.5" /><path d="M9 4V3h6v1M8.5 10h7M8.5 14h7M8.5 18h4" /></svg></span>
									<span class="home-path-line"></span>
								</span>
								<div class="home-path-card">
									<h3>Rellena el formulario</h3>
									<p>No es un examen: es contexto para conocerte antes de abrirte la puerta.</p>
									<ul class="home-chips">
										<li>Tu edad</li>
										<li>Qué buscas</li>
										<li>Cómo te gusta jugar</li>
									</ul>
								</div>
							</li>
							<li class="home-path-step">
								<span class="home-path-rail" aria-hidden="true">
									<span class="home-path-icon"><svg viewBox="0 0 24 24"><path d="M4 5.5h16v10.5H10l-6 4.5z" /></svg></span>
									<span class="home-path-line"></span>
									<span class="home-path-done"><svg viewBox="0 0 24 24"><path d="M5 12.5 10 17 19 7" /></svg></span>
								</span>
								<div class="home-path-card">
									<h3>Hablamos y entras</h3>
									<p>Revisamos cada solicitud a mano. Si encaja, te añadimos a la whitelist el mismo día.</p>
									<div class="home-path-ip">
										<p class="home-path-address">
											<span data-server-address>play.cubusfera.com</span>
											<button class="copy-ip" type="button" data-copy-ip="play.cubusfera.com">
												<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="3" /><path d="M6 15H4.5A1.5 1.5 0 0 1 3 13.5v-9A1.5 1.5 0 0 1 4.5 3h9A1.5 1.5 0 0 1 15 4.5V6" /></svg>
												<span data-copy-label>Copiar IP</span>
											</button>
										</p>
										<p class="home-path-note">Pégala en «Multijugador → Añadir servidor».</p>
									</div>
								</div>
							</li>
						</ol>
					</div>
				</section>

				<section class="home-section home-section-tight" id="mundo">
					<div class="container">
						<div class="home-head">
							<h2>Así se ve el mundo ahora mismo.</h2>
							<p class="home-links"><a class="button" href="/bluemap/">Abrir el mapa</a></p>
						</div>

						<div class="home-mosaic">
							<figure class="home-tile home-mosaic-main">
								<img src={mainShot.image} alt={mainShot.alt} width={mainShot.width} height={mainShot.height} loading="lazy" decoding="async" />
								<figcaption class="home-caption">{mainShot.caption}</figcaption>
							</figure>
							<div class="home-mosaic-side">
								{sideShots.map((shot) => (
									<figure class="home-tile">
										<img src={shot.image} alt={shot.alt} width={shot.width} height={shot.height} loading="lazy" decoding="async" />
										<figcaption class="home-caption">{shot.caption}</figcaption>
									</figure>
								))}
							</div>
							<div class="home-mosaic-row">
								{rowShots.map((shot) => (
									<figure class="home-tile">
										<img src={shot.image} alt={shot.alt} width={shot.width} height={shot.height} loading="lazy" decoding="async" />
										<figcaption class="home-caption">{shot.caption}</figcaption>
									</figure>
								))}
							</div>
						</div>

						{/* Fachada del Short: sin JavaScript es un enlace a YouTube; con él, el
						    reproductor (youtube-nocookie) solo se carga al pulsar, para no
						    pesar en la portada ni poner cookies antes de tiempo. */}
						<div class="home-tile home-tile-dark home-video" id="video">
							<div class="home-video-copy">
								<h3 class="home-video-title">{video.title}</h3>
								<p>Un minuto entre las granjas técnicas que tenemos funcionando, contado por {video.author}.</p>
								<div class="home-video-actions">
									<a class="button button-on-brand" href={video.url} target="_blank" rel="noopener noreferrer"><YouTubeIcon /> <span>Ver en YouTube</span></a>
									<a class="button-ghost button-ghost-on-brand" href={video.channelUrl} target="_blank" rel="noopener noreferrer">Canal de {video.author}</a>
								</div>
							</div>
							<a class="home-video-player" href={video.url} target="_blank" rel="noopener noreferrer" data-video-embed={video.embedUrl} data-video-title={video.title} aria-label={`Reproducir el vídeo «${video.title}»`}>
								<img src={video.poster} alt="" width="540" height="960" loading="lazy" decoding="async" />
								<span class="home-video-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z" /></svg></span>
							</a>
						</div>
					</div>
				</section>

				<section class="home-section" id="blog">
					<div class="container">
						<div class="home-head">
							<h2>Lo último del blog.</h2>
							<p class="home-links"><a class="button" href="/blog/">Ver todo el blog</a></p>
						</div>

						<ul class="home-blog">
							{posts.map((post) => (
								<li data-tag={post.tag}>
									<a class="home-tile" href={post.href}>
										<img class="home-blog-thumb" src={post.image} alt={post.imageAlt} width="1200" height="800" loading="lazy" />
										<span class="home-blog-body">
											<span class="home-blog-meta">
												<span class="home-blog-tag"><span class="home-blog-dot" aria-hidden="true"></span>{post.category}</span>
												<time datetime={post.date.toISOString().slice(0, 10)}>{formatDate(post.date)}</time>
											</span>
											<span class="home-blog-title">{post.title}</span>
										</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				</section>

				<CtaBand
					title="¿Te encaja? Nos vemos dentro."
					lead="La whitelist se abre desde Discord y te contesta una persona, no un bot."
					secondary={{ href: '/normas/', label: 'Leer las normas' }}
				/>
			</main>

			<SiteFooter />
		</div>
	</div>
	<script is:inline src="/server-status.js"></script>
	<script is:inline src="/copy-ip.js"></script>
	<script is:inline src="/scroll-reveal.js"></script>
	<script is:inline src="/video-facade.js"></script>
</Layout>
