---
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import InnerHero from '../components/InnerHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { breadcrumbSchema } from '../lib/schema';
import '../styles/phi.css';

export const prerender = true;

// El orden lo marca el raíl de iconos, sin números.
const path = [
	{
		icon: 'play',
		title: 'Conéctate al servidor',
		text: 'Añade play.cubusfera.com en Minecraft Java y conéctate. Como aún no estás en la whitelist, te desconecta y te enseña un código de 6 caracteres.',
	},
	{
		icon: 'form',
		title: 'Rellena el formulario',
		text: 'En cubusfera.com/entrar, con tu código. Son cuatro preguntas cortas y una de ellas va sobre las normas.',
	},
	{
		icon: 'door',
		title: 'Entra a jugar',
		text: 'Con cuenta premium, 16 años o más y la pregunta bien contestada, entras al momento. Si no, lo revisa una persona en 48 horas como mucho.',
	},
];

const questions = [
	'Tu edad: el servidor es para mayores de 16 años.',
	'Una pregunta sobre las normas, distinta en cada formulario.',
	'Qué te gustaría construir o aprender aquí.',
	'Cómo nos conociste.',
];

const doubts = [
	{
		title: '¿Cuánto tardáis en contestar?',
		text: 'Si tu cuenta es premium y todo encaja, nada: entras en cuanto envías. Si no, una persona lo revisa en 48 horas como mucho. No te escribimos: cuando esté aceptado, el servidor te deja entrar.',
	},
	{
		title: '¿Cuándo decís que no?',
		text: 'Si tienes menos de 16 años, si la solicitud llega vacía o si buscas un servidor masivo y competitivo. Preferimos decirlo antes que después.',
	},
	{
		title: '¿Y si mi cuenta no es premium?',
		text: 'También vale. Tu solicitud la revisa siempre una persona y, la primera vez que entres, el servidor te pedirá que crees una contraseña con /register.',
	},
];

const needs = [
	'Minecraft Java compatible con la 26.3.',
	'Cuenta premium o no premium: las dos sirven.',
	'Más de 16 años y ganas de quedarte.',
	'Nada más: ni mods que instalar ni Discord obligatorio.',
];

const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'HowTo',
		name: 'Cómo entrar en Cubusfera',
		description: 'Para entrar en Cubusfera te conectas al servidor, usas el código que te da en el formulario de cubusfera.com/entrar y, si todo encaja, entras en la whitelist.',
		step: path.map((item, index) => ({
			'@type': 'HowToStep',
			position: index + 1,
			name: item.title,
			text: item.text,
		})),
	},
	breadcrumbSchema([{ name: 'Cómo entrar' }]),
];
---

<Layout
	title="Cómo entrar al servidor: IP y whitelist — Cubusfera"
	description="Tres pasos para entrar en Cubusfera: conéctate a play.cubusfera.com, usa el código que te da el servidor en el formulario y entra. Sirve cuenta premium o no premium."
	structuredData={structuredData}
>
	<div class="phi">
		<SiteHeader>
			<InnerHero
				title="Tres pasos y"
				highlight="un código."
				lead="Te conectas, el servidor te da un código y con él rellenas un formulario corto. Si todo encaja entras al momento; si no, te contesta una persona en 48 horas."
			/>
		</SiteHeader>

		<main>
			<section class="home-band home-band-brand" aria-labelledby="camino">
				<div class="container">
					<div class="home-head">
						<div class="home-head-title">
							<h2 id="camino">El camino hasta la <span>whitelist.</span></h2>
						</div>
						<p class="home-lead">Todo pasa entre el juego y esta web. Discord es opcional: ahí está la comunidad, pero no hace falta para entrar.</p>
					</div>

					<ol class="home-path">
						{path.map((step, index) => (
							<li class="home-path-step">
								<span class="home-path-rail" aria-hidden="true">
									<span class="home-path-icon">
										{step.icon === 'play' && <svg viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="10" rx="5" /><path d="M8 10v4M6 12h4M15.5 11.5v.01M17.5 13.5v.01" /></svg>}
										{step.icon === 'form' && <svg viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="17" rx="2.5" /><path d="M9 4V3h6v1M8.5 10h7M8.5 14h7M8.5 18h4" /></svg>}
										{step.icon === 'door' && <svg viewBox="0 0 24 24"><path d="M14 4h4.5A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5H14" /><path d="M4 12h11" /><path d="m11 8 4 4-4 4" /></svg>}
									</span>
									<span class="home-path-line"></span>
									{index === path.length - 1 && <span class="home-path-done"><svg viewBox="0 0 24 24"><path d="M5 12.5 10 17 19 7" /></svg></span>}
								</span>
								<div class="home-path-card">
									<h3>{step.title}</h3>
									<p>{step.text}</p>
									{step.icon === 'form' && (
										<a class="button button-on-path" href="/entrar/">Ir al formulario</a>
									)}
									{step.icon === 'play' && (
										<div class="home-path-ip">
											<p class="home-path-address">
												<span>play.cubusfera.com</span>
												<button class="copy-ip" type="button" data-copy-ip="play.cubusfera.com">
													<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="3" /><path d="M6 15H4.5A1.5 1.5 0 0 1 3 13.5v-9A1.5 1.5 0 0 1 4.5 3h9A1.5 1.5 0 0 1 15 4.5V6" /></svg>
													<span data-copy-label>Copiar IP</span>
												</button>
											</p>
											<p class="home-path-note">Pégala en «Multijugador → Añadir servidor» y conéctate: el código sale en la pantalla de desconexión.</p>
										</div>
									)}
								</div>
							</li>
						))}
					</ol>
				</div>
			</section>

			<section class="container home-section phi-split" aria-labelledby="preguntas">
				<div class="home-head-title">
					<h2 id="preguntas">Qué te preguntamos.</h2>
					<p class="home-lead">Cuatro preguntas cortas. No es un examen: queremos saber quién llega, si el sitio le va a gustar y que ha leído las normas.</p>
				</div>

				<div class="srv-panel srv-panel-paper">
					<ul>
						{questions.map((question) => (
							<li>
								<span class="srv-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9.2 9a3 3 0 1 1 4.3 2.7c-.9.4-1.5 1.1-1.5 2.1v.4M12 17.5v.01" /></svg></span>
								{question}
							</li>
						))}
					</ul>
				</div>
			</section>

			<section class="container phi-section-tail" aria-labelledby="dudas">
				<div class="home-head">
					<div class="home-head-title">
						<h2 id="dudas">Las tres dudas de siempre.</h2>
					</div>
				</div>

				<div class="home-claims">
					{doubts.map((doubt) => (
						<article class="home-card">
							<h3>{doubt.title}</h3>
							<p>{doubt.text}</p>
						</article>
					))}
				</div>

				<div class="phi-split phi-split-top">
					<div class="srv-panel srv-panel-paper">
						<h3>Lo que necesitas</h3>
						<ul>
							{needs.map((need) => (
								<li>
									<span class="srv-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5 10 17.5 19 7" /></svg></span>
									{need}
								</li>
							))}
						</ul>
					</div>

					<aside class="srv-note">
						<h3>¿Nunca has añadido un servidor?</h3>
						<p>Te lo contamos paso a paso en la guía para entrar a Minecraft Java.</p>
						<a class="button" href="/blog/como-entrar-servidor-minecraft-java/">Leer la guía</a>
					</aside>
				</div>
			</section>

			<CtaBand
				title="Empieza por el juego."
				lead="Conéctate a play.cubusfera.com para conseguir tu código. Si ya lo tienes, ve directo al formulario."
				primary={{ href: '/entrar/', label: 'Ya tengo código' }}
				secondary={{ href: '/normas/', label: 'Leer las normas' }}
			/>
		</main>

		<SiteFooter />
	</div>
	<script is:inline src="/copy-ip.js"></script>
</Layout>
