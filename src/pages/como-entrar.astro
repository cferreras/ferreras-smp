---
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import DiscordIcon from '../components/DiscordIcon.astro';
import { breadcrumbSchema } from '../lib/schema';

const discordUrl = 'https://link.ferreras.dev/discord';
export const prerender = true;

const path = [
	{
		title: 'Entra en Discord',
		text: 'Es el punto de encuentro. Puedes mirar sin decir nada y ver cómo hablamos entre nosotros.',
	},
	{
		title: 'Lee la información',
		text: 'El canal de información y las normas de convivencia. Cinco minutos que evitan malentendidos.',
	},
	{
		title: 'Rellena el formulario',
		text: 'Está en su propio canal. Contesta con calma: no buscamos una respuesta preparada.',
	},
	{
		title: 'Hablamos y entras',
		text: 'Leemos cada solicitud a mano. Si encaja, seguimos por Discord y te añadimos a la whitelist.',
	},
];

const questions = [
	'Tu edad y cómo quieres que te llamemos.',
	'Qué te gustaría construir o aprender aquí.',
	'Si has jugado antes en servidores y qué convivencia buscas.',
	'Si has leído las normas y aceptas que el mundo se comparte.',
	'Cómo nos conociste.',
];

const doubts = [
	{
		title: '¿Cuánto tardáis en contestar?',
		text: 'No hay reloj automático: alguien tiene que leer tu solicitud con atención. Si pasan varios días, escribe otra vez en el mismo canal y la recuperamos.',
	},
	{
		title: '¿Cuándo decís que no?',
		text: 'Cuando la solicitud llega vacía, cuando se ve que las normas dan igual o cuando buscas un servidor masivo y competitivo. Preferimos decirlo antes que después.',
	},
	{
		title: '¿Y si me aprobáis?',
		text: 'Te lo confirmamos por Discord y añadimos tu cuenta. Ya solo queda abrir Minecraft, añadir el servidor y saludar al llegar.',
	},
];

const needs = [
	'Minecraft Java compatible con la 26.2.',
	'Más de 16 años y ganas de quedarte.',
	'Nada más: no se instalan mods para entrar.',
];

const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'HowTo',
		name: 'Cómo entrar en Ferreras SMP',
		description: 'El acceso a Ferreras SMP se pide desde Discord y se revisa a mano antes de añadir la cuenta a la whitelist.',
		step: path.map((item, index) => ({
			'@type': 'HowToStep',
			position: index + 1,
			name: item.title,
			text: item.text,
		})),
	},
	breadcrumbSchema([{ name: 'Cómo entrar' }]),
];
---

<Layout
	title="Cómo entrar — Ferreras SMP"
	description="Cuatro pasos para entrar en Ferreras SMP: Discord, normas, formulario y revisión manual antes de la whitelist."
	structuredData={structuredData}
>
	<SiteHeader>
		<div class="container page-lead">
			<span class="chip">Cómo entrar</span>
			<h1>Cuatro pasos y <span>una conversación.</span></h1>
			<p>No hay registro automático ni formulario escondido. Entras en Discord, nos cuentas cómo juegas y te contestamos a mano.</p>
		</div>
	</SiteHeader>

	<main>
		<section class="section">
			<div class="container">
				<h2 class="section-title">El camino hasta la whitelist.</h2>

				<ol class="steps steps-4">
					{path.map((step, index) => (
						<li class="step">
							<span class="step-number">{String(index + 1).padStart(2, '0')}</span>
							<strong class="step-title">{step.title}</strong>
							<p class="step-description">{step.text}</p>
						</li>
					))}
				</ol>
			</div>
		</section>

		<section class="band band-lime">
			<div class="container ask-layout">
				<div class="ask-intro">
					<h2 class="section-title">Qué te preguntamos.</h2>
					<p class="band-lead">Cinco preguntas cortas. No es un examen: solo queremos saber quién llega y si el sitio le va a gustar.</p>
				</div>

				<ul class="check-list">
					{questions.map((question) => (
						<li>
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6.5" /></svg>
							<p>{question}</p>
						</li>
					))}
				</ul>
			</div>
		</section>

		<section class="section">
			<div class="container">
				<h2 class="section-title">Las tres dudas de siempre.</h2>

				<div class="doubts">
					{doubts.map((doubt) => (
						<article class="card">
							<h3>{doubt.title}</h3>
							<p>{doubt.text}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="section">
			<div class="container">
				<div class="needs-layout">
					<div class="needs-card">
						<h2>Lo que necesitas</h2>
						<ul class="check-list">
							{needs.map((need) => (
								<li>
									<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6.5" /></svg>
									<p>{need}</p>
								</li>
							))}
						</ul>
					</div>

					<div class="ip-panel needs-ip">
						<div>
							<p class="ip-label">IP del servidor</p>
							<p class="ip-value">mc.ferreras.dev</p>
						</div>
						<p class="ip-note">Pégala en «Multijugador → Añadir servidor». Solo conecta una vez estás en la whitelist.</p>
						<button class="copy-ip" type="button" data-copy-ip="mc.ferreras.dev">
							<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="3" /><path d="M6 15H4.5A1.5 1.5 0 0 1 3 13.5v-9A1.5 1.5 0 0 1 4.5 3h9A1.5 1.5 0 0 1 15 4.5V6" /></svg>
							<span data-copy-label>Copiar</span>
						</button>
					</div>
				</div>

				<p class="after-note">¿Nunca has añadido un servidor? Te lo contamos paso a paso en la <a href="/blog/como-entrar-servidor-minecraft-java/">guía para entrar a Minecraft Java</a>.</p>
			</div>
		</section>

		<section class="band band-amber">
			<div class="container">
				<h2 class="section-title">Empieza por Discord.</h2>
				<p class="band-lead">Es el único sitio desde el que se abre la whitelist. Te contesta una persona, no un bot.</p>
				<div class="band-actions">
					<a class="button button-on-amber" href={discordUrl} target="_blank" rel="noopener noreferrer"><DiscordIcon /> <span>Entrar en Discord</span></a>
					<a class="button-ghost button-ghost-on-amber" href="/normas/">Leer las normas</a>
				</div>
			</div>
		</section>
	</main>

	<SiteFooter />
	<script is:inline src="/copy-ip.js"></script>
</Layout>
