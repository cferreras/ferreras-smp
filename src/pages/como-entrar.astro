---
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import DiscordIcon from '../components/DiscordIcon.astro';
import InnerHero from '../components/InnerHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { breadcrumbSchema } from '../lib/schema';
import '../styles/phi.css';

const discordUrl = 'https://discord.com/invite/xW7yyHRJvE';
export const prerender = true;

const path = [
	{
		title: 'Entra en Discord',
		text: 'Es el punto de encuentro. Puedes mirar sin decir nada y ver cómo hablamos entre nosotros.',
	},
	{
		title: 'Lee la información',
		text: 'El canal de información y las normas de convivencia. Cinco minutos que evitan malentendidos.',
	},
	{
		title: 'Rellena el formulario',
		text: 'Está en su propio canal. Contesta con calma: no buscamos una respuesta preparada.',
	},
	{
		title: 'Hablamos y entras',
		text: 'Leemos cada solicitud a mano. Si encaja, seguimos por Discord y te añadimos a la whitelist.',
	},
];

const questions = [
	'Tu edad y cómo quieres que te llamemos.',
	'Qué te gustaría construir o aprender aquí.',
	'Si has jugado antes en servidores y qué convivencia buscas.',
	'Si has leído las normas y aceptas que el mundo se comparte.',
	'Cómo nos conociste.',
];

const doubts = [
	{
		title: '¿Cuánto tardáis en contestar?',
		text: 'No hay reloj automático: alguien tiene que leer tu solicitud con atención. Si pasan varios días, escribe otra vez en el mismo canal y la recuperamos.',
	},
	{
		title: '¿Cuándo decís que no?',
		text: 'Cuando la solicitud llega vacía, cuando se ve que las normas dan igual o cuando buscas un servidor masivo y competitivo. Preferimos decirlo antes que después.',
	},
	{
		title: '¿Y si me aprobáis?',
		text: 'Te lo confirmamos por Discord y añadimos tu cuenta. Ya solo queda abrir Minecraft, añadir el servidor y saludar al llegar.',
	},
];

const needs = [
	'Minecraft Java compatible con la 26.3.',
	'Más de 16 años y ganas de quedarte.',
	'Nada más: no se instalan mods para entrar.',
];

const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'HowTo',
		name: 'Cómo entrar en Cubusfera',
		description: 'El acceso a Cubusfera se pide desde Discord y se revisa a mano antes de añadir la cuenta a la whitelist.',
		step: path.map((item, index) => ({
			'@type': 'HowToStep',
			position: index + 1,
			name: item.title,
			text: item.text,
		})),
	},
	breadcrumbSchema([{ name: 'Cómo entrar' }]),
];
---

<Layout
	title="Cómo entrar — Cubusfera"
	description="Cuatro pasos para entrar en Cubusfera: Discord, normas, formulario y revisión manual antes de la whitelist."
	structuredData={structuredData}
>
	<div class="phi">
		<SiteHeader>
			<InnerHero
				chip="Cómo entrar"
				title="Cuatro pasos y"
				highlight="una conversación."
				lead="No hay registro automático ni formulario escondido. Entras en Discord, nos cuentas cómo juegas y te contestamos a mano."
			/>
		</SiteHeader>

		<main>
			<section class="home-band home-band-lime" aria-labelledby="camino">
				<div class="container">
					<div class="home-head">
						<div class="home-head-title">
							<span class="home-kicker">01 — El camino</span>
							<h2 id="camino">El camino hasta la whitelist.</h2>
						</div>
						<a class="button button-on-lime home-head-action" href={discordUrl} target="_blank" rel="noopener noreferrer"><DiscordIcon /> <span>Entrar en Discord</span></a>
					</div>

					<ol class="home-steps home-steps-4">
						{path.map((step, index) => (
							<li class="home-step">
								<span class="home-step-number">{String(index + 1).padStart(2, '0')}</span>
								<strong class="home-step-title">{step.title}</strong>
								<p>{step.text}</p>
							</li>
						))}
					</ol>

					<div class="home-ip">
						<div class="home-ip-address">
							<p class="home-kicker">IP del servidor</p>
							<p class="home-ip-value">play.cubusfera.com</p>
						</div>
						<p class="home-ip-note">Pégala en «Multijugador → Añadir servidor». Solo conecta una vez estás en la whitelist.</p>
						<button class="copy-ip" type="button" data-copy-ip="play.cubusfera.com">
							<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="3" /><path d="M6 15H4.5A1.5 1.5 0 0 1 3 13.5v-9A1.5 1.5 0 0 1 4.5 3h9A1.5 1.5 0 0 1 15 4.5V6" /></svg>
							<span data-copy-label>Copiar IP</span>
						</button>
					</div>
				</div>
			</section>

			<section class="container home-section phi-split" aria-labelledby="preguntas">
				<div class="home-head-title">
					<span class="home-kicker">02 — El formulario</span>
					<h2 id="preguntas">Qué te preguntamos.</h2>
					<p class="home-lead">Cinco preguntas cortas. No es un examen: solo queremos saber quién llega y si el sitio le va a gustar.</p>
				</div>

				<div class="srv-panel srv-panel-paper">
					<ol class="phi-numbered">
						{questions.map((question, index) => (
							<li>
								<span class="srv-mark srv-mark-number" aria-hidden="true">{index + 1}</span>
								{question}
							</li>
						))}
					</ol>
				</div>
			</section>

			<section class="container phi-section-tail" aria-labelledby="dudas">
				<div class="home-head">
					<div class="home-head-title">
						<span class="home-kicker">03 — Las dudas</span>
						<h2 id="dudas">Las tres dudas de siempre.</h2>
					</div>
				</div>

				<div class="home-claims">
					{doubts.map((doubt) => (
						<article class="home-card">
							<h3>{doubt.title}</h3>
							<p>{doubt.text}</p>
						</article>
					))}
				</div>

				<div class="phi-split phi-split-top">
					<div class="srv-panel srv-panel-paper">
						<h3>Lo que necesitas</h3>
						<ul>
							{needs.map((need) => (
								<li>
									<span class="srv-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5 10 17.5 19 7" /></svg></span>
									{need}
								</li>
							))}
						</ul>
					</div>

					<aside class="srv-note">
						<div class="home-card-icon home-card-icon-violet">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.6 20.5 7v10L12 21.4 3.5 17V7z" /><path d="M3.5 7 12 11.6 20.5 7" /><path d="M12 11.6V21.4" /></svg>
						</div>
						<span class="home-kicker">Primera vez</span>
						<h3>¿Nunca has añadido un servidor?</h3>
						<p>Te lo contamos paso a paso en la guía para entrar a Minecraft Java.</p>
						<a href="/blog/como-entrar-servidor-minecraft-java/">
							Leer la guía
							<svg class="blog-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
						</a>
					</aside>
				</div>
			</section>

			<CtaBand
				title="Empieza por Discord."
				lead="Es el único sitio desde el que se abre la whitelist. Te contesta una persona, no un bot."
				secondary={{ href: '/normas/', label: 'Leer las normas' }}
			/>
		</main>

		<SiteFooter />
	</div>
	<script is:inline src="/copy-ip.js"></script>
</Layout>
