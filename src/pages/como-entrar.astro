---
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import DiscordIcon from '../components/DiscordIcon.astro';
import InnerHero from '../components/InnerHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { breadcrumbSchema } from '../lib/schema';
import '../styles/phi.css';

const discordUrl = 'https://discord.com/invite/xW7yyHRJvE';
export const prerender = true;

// El orden lo marca el raíl de iconos, sin números.
const path = [
	{
		icon: 'discord',
		title: 'Entra en Discord',
		text: 'Es el punto de encuentro. Puedes mirar sin decir nada y ver cómo hablamos entre nosotros.',
	},
	{
		icon: 'book',
		title: 'Lee la información',
		text: 'El canal de información y las normas de convivencia. Cinco minutos que evitan malentendidos.',
	},
	{
		icon: 'form',
		title: 'Rellena el formulario',
		text: 'Está en su propio canal. Contesta con calma: no buscamos una respuesta preparada.',
	},
	{
		icon: 'chat',
		title: 'Hablamos y entras',
		text: 'Leemos cada solicitud a mano. Si encaja, seguimos por Discord y te añadimos a la whitelist.',
	},
];

const questions = [
	'Tu edad y cómo quieres que te llamemos.',
	'Qué te gustaría construir o aprender aquí.',
	'Si has jugado antes en servidores y qué convivencia buscas.',
	'Si has leído las normas y aceptas que el mundo se comparte.',
	'Cómo nos conociste.',
];

const doubts = [
	{
		title: '¿Cuánto tardáis en contestar?',
		text: 'No hay reloj automático: alguien tiene que leer tu solicitud con atención. Si pasan varios días, escribe otra vez en el mismo canal y la recuperamos.',
	},
	{
		title: '¿Cuándo decís que no?',
		text: 'Cuando la solicitud llega vacía, cuando se ve que las normas dan igual o cuando buscas un servidor masivo y competitivo. Preferimos decirlo antes que después.',
	},
	{
		title: '¿Y si me aprobáis?',
		text: 'Te lo confirmamos por Discord y añadimos tu cuenta. Ya solo queda abrir Minecraft, añadir el servidor y saludar al llegar. Si tu cuenta no es premium, el servidor te pedirá una contraseña la primera vez.',
	},
];

const needs = [
	'Minecraft Java compatible con la 26.3.',
	'Cuenta premium o no premium: las dos sirven.',
	'Más de 16 años y ganas de quedarte.',
	'Nada más: no se instalan mods para entrar.',
];

const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'HowTo',
		name: 'Cómo entrar en Cubusfera',
		description: 'El acceso a Cubusfera se pide desde Discord y se revisa a mano antes de añadir la cuenta a la whitelist.',
		step: path.map((item, index) => ({
			'@type': 'HowToStep',
			position: index + 1,
			name: item.title,
			text: item.text,
		})),
	},
	breadcrumbSchema([{ name: 'Cómo entrar' }]),
];
---

<Layout
	title="Cómo entrar al servidor: IP y whitelist — Cubusfera"
	description="Cuatro pasos para entrar en Cubusfera: Discord, normas, formulario y revisión manual antes de la whitelist. Sirve cuenta premium o no premium."
	structuredData={structuredData}
>
	<div class="phi">
		<SiteHeader>
			<InnerHero
				title="Cuatro pasos y"
				highlight="una conversación."
				lead="No hay registro automático ni formulario escondido. Entras en Discord, nos cuentas cómo juegas y te contestamos a mano."
			/>
		</SiteHeader>

		<main>
			<section class="home-band home-band-brand" aria-labelledby="camino">
				<div class="container">
					<div class="home-head">
						<div class="home-head-title">
							<h2 id="camino">El camino hasta la <span>whitelist.</span></h2>
						</div>
						<p class="home-lead">Todo pasa en Discord. Ahí ves cómo hablamos antes de decidir nada.</p>
					</div>

					<ol class="home-path home-path-4">
						{path.map((step, index) => (
							<li class="home-path-step">
								<span class="home-path-rail" aria-hidden="true">
									<span class="home-path-icon">
										{step.icon === 'discord' && <DiscordIcon />}
										{step.icon === 'book' && <svg viewBox="0 0 24 24"><path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H11v16H5.5A1.5 1.5 0 0 1 4 18.5zM20 5.5A1.5 1.5 0 0 0 18.5 4H13v16h5.5a1.5 1.5 0 0 0 1.5-1.5z" /></svg>}
										{step.icon === 'form' && <svg viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="17" rx="2.5" /><path d="M9 4V3h6v1M8.5 10h7M8.5 14h7M8.5 18h4" /></svg>}
										{step.icon === 'chat' && <svg viewBox="0 0 24 24"><path d="M4 5.5h16v10.5H10l-6 4.5z" /></svg>}
									</span>
									<span class="home-path-line"></span>
									{index === path.length - 1 && <span class="home-path-done"><svg viewBox="0 0 24 24"><path d="M5 12.5 10 17 19 7" /></svg></span>}
								</span>
								<div class="home-path-card">
									<h3>{step.title}</h3>
									<p>{step.text}</p>
									{step.icon === 'discord' && (
										<a class="button button-on-path" href={discordUrl} target="_blank" rel="noopener noreferrer"><DiscordIcon /> <span>Entrar en Discord</span></a>
									)}
									{index === path.length - 1 && (
										<div class="home-path-ip">
											<p class="home-path-address">
												<span>play.cubusfera.com</span>
												<button class="copy-ip" type="button" data-copy-ip="play.cubusfera.com">
													<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="3" /><path d="M6 15H4.5A1.5 1.5 0 0 1 3 13.5v-9A1.5 1.5 0 0 1 4.5 3h9A1.5 1.5 0 0 1 15 4.5V6" /></svg>
													<span data-copy-label>Copiar IP</span>
												</button>
											</p>
											<p class="home-path-note">Pégala en «Multijugador → Añadir servidor». Conecta una vez estás en la whitelist.</p>
										</div>
									)}
								</div>
							</li>
						))}
					</ol>
				</div>
			</section>

			<section class="container home-section phi-split" aria-labelledby="preguntas">
				<div class="home-head-title">
					<h2 id="preguntas">Qué te preguntamos.</h2>
					<p class="home-lead">Cinco preguntas cortas. No es un examen: solo queremos saber quién llega y si el sitio le va a gustar.</p>
				</div>

				<div class="srv-panel srv-panel-paper">
					<ul>
						{questions.map((question) => (
							<li>
								<span class="srv-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9.2 9a3 3 0 1 1 4.3 2.7c-.9.4-1.5 1.1-1.5 2.1v.4M12 17.5v.01" /></svg></span>
								{question}
							</li>
						))}
					</ul>
				</div>
			</section>

			<section class="container phi-section-tail" aria-labelledby="dudas">
				<div class="home-head">
					<div class="home-head-title">
						<h2 id="dudas">Las tres dudas de siempre.</h2>
					</div>
				</div>

				<div class="home-claims">
					{doubts.map((doubt) => (
						<article class="home-card">
							<h3>{doubt.title}</h3>
							<p>{doubt.text}</p>
						</article>
					))}
				</div>

				<div class="phi-split phi-split-top">
					<div class="srv-panel srv-panel-paper">
						<h3>Lo que necesitas</h3>
						<ul>
							{needs.map((need) => (
								<li>
									<span class="srv-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5 10 17.5 19 7" /></svg></span>
									{need}
								</li>
							))}
						</ul>
					</div>

					<aside class="srv-note">
						<h3>¿Nunca has añadido un servidor?</h3>
						<p>Te lo contamos paso a paso en la guía para entrar a Minecraft Java.</p>
						<a class="button" href="/blog/como-entrar-servidor-minecraft-java/">Leer la guía</a>
					</aside>
				</div>
			</section>

			<CtaBand
				title="Empieza por Discord."
				lead="Es el único sitio desde el que se abre la whitelist. Te contesta una persona, no un bot."
				secondary={{ href: '/normas/', label: 'Leer las normas' }}
			/>
		</main>

		<SiteFooter />
	</div>
	<script is:inline src="/copy-ip.js"></script>
</Layout>
