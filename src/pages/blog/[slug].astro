---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';

export const prerender = true;

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const discordUrl = 'https://link.ferreras.dev/discord';
const siteUrl = Astro.site ?? new URL('https://mc.ferreras.dev');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const imageUrl = new URL(post.data.image, siteUrl).toString();
const datePublished = post.data.publishedAt.toISOString();
const dateModified = (post.data.updatedAt ?? post.data.publishedAt).toISOString();
const blogPostingSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.data.title,
	description: post.data.description,
	image: imageUrl,
	datePublished,
	dateModified,
	author: { '@type': 'Person', name: post.data.author },
	publisher: { '@id': 'https://mc.ferreras.dev/#organization' },
	mainEntityOfPage: canonicalUrl,
	inLanguage: 'es-ES',
};
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://mc.ferreras.dev/' },
		{ '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://mc.ferreras.dev/blog/' },
		{ '@type': 'ListItem', position: 3, name: post.data.title },
	],
};
---

<Layout
	title={`${post.data.title} — Ferreras SMP`}
	description={post.data.description}
	image={post.data.image}
	imageAlt={post.data.imageAlt}
	type="article"
	author={post.data.author}
	section={post.data.category}
	tags={post.data.tags}
	publishedAt={post.data.publishedAt}
	updatedAt={post.data.updatedAt}
	structuredData={[blogPostingSchema, breadcrumbSchema]}
>
	<SiteHeader />
	<main>
		<section class="content-section">
			<div class="container">
				<header class="article-header">
					<div class="article-meta"><span>{post.data.category}</span><span>{post.data.publishedAt.toLocaleDateString('es-ES', { day: '2-digit', month: 'long', year: 'numeric' })}</span></div>
					<h1>{post.data.title}</h1>
					<p>{post.data.description}</p>
				</header>
				<img class="article-cover" src={post.data.image} alt={post.data.imageAlt} width="1200" height="800" />
				<div class="article-author" aria-label="Autor del artículo">
					<p><strong>Escrito por {post.data.author}</strong></p>
					<p>{post.data.author} administra Ferreras SMP y mantiene la configuración técnica del servidor. Si quieres comentar una duda sobre este artículo, puedes encontrarle en <a href={discordUrl} target="_blank" rel="noopener noreferrer">Discord de Ferreras SMP</a>.</p>
				</div>
				<div class="content-layout">
					<aside class="content-index"><strong>Ferreras SMP</strong><a href="/blog/">Volver al blog</a></aside>
					<article class="prose"><Content /></article>
				</div>
			</div>
		</section>
	</main>
	<SiteFooter />
</Layout>
