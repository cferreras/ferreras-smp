---
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import DiscordIcon from '../components/DiscordIcon.astro';
import InnerHero from '../components/InnerHero.astro';
import { breadcrumbSchema } from '../lib/schema';
import '../styles/phi.css';

const discordUrl = 'https://discord.com/invite/xW7yyHRJvE';
export const prerender = true;

// Las preguntas viven en un array para que el marcado visible y el FAQPage
// salgan de la misma fuente y no puedan desincronizarse.
const faqs = [
	{
		question: '¿Necesito instalar mods para entrar?',
		answer: 'No. Puedes conectarte con Minecraft Java Vanilla; Fabric y los mods del servidor ya están instalados donde corresponde. En <a href="/blog/que-mods-hay-ferreras-smp/">la lista de mods server-side</a> explicamos qué hace cada herramienta.',
	},
	{
		question: '¿Qué versión utiliza el servidor?',
		answer: 'Cubusfera está pensado para Minecraft Java 26.2. La dirección de conexión es <code>play.cubusfera.com</code>. Puedes consultar <a href="/blog/que-mods-hay-ferreras-smp/">el detalle técnico del servidor</a> si quieres saber cómo mantenemos la experiencia cercana a Vanilla.',
	},
	{
		question: '¿Hay whitelist?',
		answer: 'Sí. Primero entras en Discord, lees la información y completas el formulario. Las solicitudes se revisan manualmente antes de darte acceso; <a href="/como-entrar/">aquí está el proceso completo de whitelist</a>.',
	},
	{
		question: '¿Puedo jugar a mi ritmo?',
		answer: 'Sí. Puedes desarrollar proyectos propios y participar en construcciones colectivas. Lo que pedimos es respetar las normas y mantener una comunicación básica con la comunidad. La <a href="/servidor/">página del servidor</a> explica mejor ese equilibrio.',
	},
	{
		question: '¿Está permitido el PvP?',
		answer: 'Está habilitado técnicamente, pero no como conducta normal. Solo se permite si las dos personas acuerdan el enfrentamiento y nadie se queda con los objetos de la otra; está desarrollado en las <a href="/normas/">normas de convivencia</a>.',
	},
	{
		question: '¿El mundo se reiniciará?',
		answer: 'La intención es conservarlo durante mucho tiempo o indefinidamente. El mundo persistente forma parte de la propuesta y de la <a href="/servidor/">filosofía del servidor</a>.',
	},
	{
		question: '¿Qué pasa si hay un robo o un daño?',
		answer: 'Ledger permite consultar acciones y existen copias de seguridad para investigar incidentes graves. Escríbenos por Discord con el máximo contexto posible y revisa las <a href="/normas/">normas sobre construcciones y objetos</a>.',
	},
];

const plainText = (html: string) => html.replace(/<[^>]+>/g, '');

const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		inLanguage: 'es-ES',
		mainEntity: faqs.map((faq) => ({
			'@type': 'Question',
			name: faq.question,
			acceptedAnswer: { '@type': 'Answer', text: plainText(faq.answer) },
		})),
	},
	breadcrumbSchema([{ name: 'Preguntas frecuentes' }]),
];
---

<Layout
	title="Preguntas frecuentes — Cubusfera"
	description="Respuestas sobre Vanilla, Fabric, acceso, whitelist, PvP, duplicaciones y permanencia del mundo."
	structuredData={structuredData}
>
	<div class="phi">
		<SiteHeader>
			<InnerHero
				chip={`Preguntas frecuentes · ${faqs.length}`}
				title="Preguntas frecuentes: lo importante,"
				highlight="sin rodeos."
				lead="Si después de leer esto te queda una duda, ven a Discord. Preferimos responder una pregunta concreta antes que dar por hecho que todo el mundo entiende lo mismo."
			/>
		</SiteHeader>

		<main>
			<section class="container home-section phi-split">
				<div class="faq">
					{faqs.map((faq, index) => (
						<details open={index === 0}>
							<summary>
								<span class="faq-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
								<h2>{faq.question}</h2>
								<span class="faq-toggle" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg></span>
							</summary>
							<p set:html={faq.answer}></p>
						</details>
					))}
				</div>

				<aside class="srv-note faq-aside">
					<div class="home-card-icon home-card-icon-violet">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12.5a7 7 0 0 1-7 7H8l-4 2.5.9-3.4A7 7 0 0 1 11 4.5h2a7 7 0 0 1 7 7z" /></svg>
					</div>
					<span class="home-kicker">¿Falta la tuya?</span>
					<h3>Pregunta en Discord.</h3>
					<p>Te contesta una persona. Es también donde se abre la whitelist, así que ya estarás en el sitio.</p>
					<a class="button" href={discordUrl} target="_blank" rel="noopener noreferrer"><DiscordIcon /> <span>Entrar en Discord</span></a>
				</aside>
			</section>
		</main>

		<SiteFooter />
	</div>
</Layout>
