---
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import DiscordIcon from '../components/DiscordIcon.astro';
import InnerHero from '../components/InnerHero.astro';
import '../styles/phi.css';

export const prerender = true;

const mapUrl = 'https://mapa.cubusfera.com/';

// Capas de marcadores que publica BlueMap en cada dimensión. Sin recuentos:
// crecen a medida que se genera mundo y aquí se quedarían viejos.
const layers = [
	{
		dimension: 'Overworld',
		items: [
			'Aldeas',
			'Mansiones del bosque',
			'Templos de la jungla',
			'Chozas de bruja',
			'Avanzadas de saqueadores',
			'Fortalezas',
			'Ciudades antiguas',
			'Cámaras de prueba',
			'Minas abandonadas',
			'Monumentos oceánicos',
			'Naufragios',
			'Portales en ruinas',
			'Otras estructuras',
		],
	},
	{
		dimension: 'Nether',
		items: ['Fortalezas del Nether', 'Bastiones', 'Portales en ruinas', 'Otras estructuras'],
	},
	{
		dimension: 'End',
		items: ['Ciudades del End'],
	},
];
---

<Layout
	title="BlueMap — Mapa 3D de Cubusfera"
	description="Explora el mundo de Cubusfera en 3D desde el navegador, con marcadores de aldeas, fortalezas, ciudades antiguas y otras estructuras del Overworld, el Nether y el End."
>
	<div class="phi">
		<SiteHeader>
			<InnerHero
				chip="BlueMap · Activo"
				title="El mundo de Cubusfera,"
				highlight="en 3D y en directo."
				lead="Recorre el mapa desde el navegador, cambia entre Overworld, Nether y End, y localiza estructuras con sus coordenadas antes de salir de casa."
			/>
		</SiteHeader>

		<main>
			<section class="container home-section">
				<div class="map-frame">
					<iframe
						src={mapUrl}
						title="Mapa interactivo BlueMap de Cubusfera"
						allow="fullscreen"
						allowfullscreen
						referrerpolicy="strict-origin-when-cross-origin"
					></iframe>
				</div>
				<p class="gal-more">
					<a class="button" href={mapUrl} target="_blank" rel="noopener">Abrir el mapa a pantalla completa</a>
				</p>
			</section>

			<section class="container home-section phi-split">
				{/* Overworld en una columna; Nether y End, más cortas, comparten la otra. */}
				<div class="map-layers">
					{[layers.slice(0, 1), layers.slice(1)].map((column) => (
						<div class="map-layers-column">
							{column.map((layer) => (
								<div>
									<h3>{layer.dimension}</h3>
									<ul class="rule-list">
										{layer.items.map((item) => <li>{item}</li>)}
									</ul>
								</div>
							))}
						</div>
					))}
				</div>

				<div class="phi-aside-copy">
					<span class="home-kicker">Marcadores</span>
					<h2>Cada estructura, con sus coordenadas.</h2>
					<p class="home-lead">Abre el menú del mapa para activar o esconder cada capa. Al pulsar un marcador verás qué es y su posición X · Y · Z. Lo que construimos se comparte en Discord y las mejores capturas pasan a la <a href="/galeria/">galería</a>.</p>
					<a class="button" href="https://discord.com/invite/xW7yyHRJvE" target="_blank" rel="noopener noreferrer"><DiscordIcon /> <span>Ver la comunidad</span></a>
				</div>
			</section>
		</main>

		<SiteFooter />
	</div>
</Layout>
