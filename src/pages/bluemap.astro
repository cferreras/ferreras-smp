---
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import DiscordIcon from '../components/DiscordIcon.astro';
import InnerHero from '../components/InnerHero.astro';
import '../styles/phi.css';

export const prerender = true;
---

<Layout
	title="BlueMap — Cubusfera"
	description="El mapa interactivo de Cubusfera llegará cuando BlueMap esté activo y tenga una URL pública."
	noindex
>
	<div class="phi">
		<SiteHeader>
			<InnerHero
				chip="BlueMap · Previsto"
				title="BlueMap de Cubusfera: el mapa está"
				highlight="por llegar."
				lead="Estamos preparando un espacio para explorar el mundo desde la web. BlueMap está previsto, pero todavía no está activo y no queremos fingir que lo está."
			/>
		</SiteHeader>

		<main>
			<section class="container home-section phi-split">
				<figure class="map-figure">
					<img src="/images/minecraft-map-item.webp" alt="Render generado de un objeto mapa de Minecraft abierto para Cubusfera" width="1200" height="800" />
				</figure>

				<div class="phi-aside-copy">
					<span class="home-kicker">Mientras tanto</span>
					<h2>Cuando esté listo, estará aquí.</h2>
					<p class="home-lead">La integración prevista permitirá consultar el mapa, localizar proyectos y entender mejor cómo se va llenando el mundo. Hasta entonces, las mejores capturas se comparten en Discord y pasan a la <a href="/galeria/">galería</a>.</p>
					<a class="button" href="https://discord.com/invite/xW7yyHRJvE" target="_blank" rel="noopener noreferrer"><DiscordIcon /> <span>Ver la comunidad</span></a>
				</div>
			</section>
		</main>

		<SiteFooter />
	</div>
</Layout>
