---
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import InnerHero from '../components/InnerHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { breadcrumbSchema } from '../lib/schema';
import { shots } from '../lib/gallery';
import '../styles/phi.css';

export const prerender = true;

// El mosaico sigue la rejilla áurea: las dos capturas casi cuadradas abren en
// 727 + 449, la primera panorámica ocupa el ancho y el resto va de dos en dos.
const layout = (index: number) => (index === 0 ? 'gal-main' : index === 1 ? 'gal-side' : index === 2 ? 'gal-wide' : 'gal-half');

// Las capturas son originales del servidor: describirlas como ImageObject es la
// única señal estructurada que esta página puede aportar sin inventar texto.
const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'ImageGallery',
		name: 'Galería de Cubusfera',
		description: 'Capturas del mundo survival de Cubusfera compartidas por su comunidad.',
		inLanguage: 'es-ES',
		isPartOf: { '@id': 'https://cubusfera.com/#website' },
		associatedMedia: shots.map((shot) => ({
			'@type': 'ImageObject',
			contentUrl: new URL(shot.src, 'https://cubusfera.com').toString(),
			caption: shot.caption,
			description: shot.alt,
			width: shot.width,
			height: shot.height,
		})),
	},
	breadcrumbSchema([{ name: 'Galería' }]),
];
---

<Layout
	title="Galería — Cubusfera"
	description="Una selección visual del mundo y el ambiente de Cubusfera."
	structuredData={structuredData}
>
	<div class="phi">
		<SiteHeader>
			<InnerHero
				chip={`Galería · ${shots.length} capturas`}
				title="Galería de Cubusfera: un mundo que se"
				highlight="va llenando."
				lead="La galería se alimenta de las capturas que compartimos en Discord. Esta primera selección sirve para enseñar el tono del mundo: proyectos, paisajes y lugares que merece la pena conservar."
			/>
		</SiteHeader>

		<main>
			<section class="container home-section">
				<div class="gal-grid">
					{shots.map((shot, index) => (
						<figure class={layout(index)}>
							<img src={shot.src} alt={shot.alt} width={shot.width} height={shot.height} loading={index < 2 ? 'eager' : 'lazy'} decoding="async" />
							<figcaption class="home-caption">{shot.caption}</figcaption>
						</figure>
					))}
				</div>

				<p class="gal-more">
					<a href="/bluemap/">El mapa del mundo, por llegar →</a>
				</p>
			</section>

			<CtaBand
				title="¿Te encaja? Nos vemos dentro."
				lead="La whitelist se abre desde Discord y te contesta una persona, no un bot."
				secondary={{ href: '/servidor/', label: 'Conocer el servidor' }}
			/>
		</main>

		<SiteFooter />
	</div>
</Layout>
