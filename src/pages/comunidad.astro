---
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import InnerHero from '../components/InnerHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { breadcrumbSchema } from '../lib/schema';
import { getMembers } from '../lib/members';
import '../styles/phi.css';

// Se pinta en cada visita con la lista del panel; la CDN la guarda un minuto.
export const prerender = false;

const { ok, members, checkedAt, onlineFresh } = await getMembers();

Astro.response.headers.set(
	'Cache-Control',
	ok ? 'public, max-age=0, s-maxage=60, stale-while-revalidate=60' : 'public, max-age=0, s-maxage=10',
);

const structuredData = [breadcrumbSchema([{ name: 'Comunidad' }])];

const roleLabels = { owner: 'Owner', admin: 'Admin', helper: 'Ayudante' } as const;

const monthFormat = new Intl.DateTimeFormat('es-ES', { month: 'long', year: 'numeric', timeZone: 'Europe/Madrid' });
const timeFormat = new Intl.DateTimeFormat('es-ES', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Madrid' });

const count = members.length;
const onlineCount = members.filter((member) => member.online).length;

const heading = `${count} ${count === 1 ? 'persona' : 'personas'} en la whitelist.`;

let onlineSentence = 'Ahora mismo no podemos comprobar quién está conectado.';
if (onlineFresh && checkedAt) {
	const people = onlineCount === 1 ? '1 persona' : `${onlineCount} personas`;
	onlineSentence = onlineCount === 0
		? `Ahora mismo no hay nadie conectado (comprobado a las ${timeFormat.format(checkedAt)}).`
		: `Ahora mismo hay ${people} jugando (comprobado a las ${timeFormat.format(checkedAt)}).`;
}

const cta = {
	title: '¿Te apuntas?',
	lead: 'Conéctate al servidor, te dará un código y con él rellenas un formulario corto. Las dos primeras semanas son de prueba.',
};
---

<Layout
	title="Comunidad: miembros del servidor — Cubusfera"
	description="Quién juega en Cubusfera: los miembros del servidor, quién está en su periodo de prueba y quién está conectado ahora."
	structuredData={structuredData}
>
	<div class="phi">
		<SiteHeader>
			<InnerHero
				title="Quién juega en"
				highlight="Cubusfera."
				lead="Cada cabeza es una persona de la whitelist. Somos una comunidad pequeña: en el servidor caben 20 jugadores a la vez."
			/>
		</SiteHeader>

		<main>
			<section class="container home-section" aria-labelledby="miembros">
				{ok ? (
					<>
						<div class="home-head">
							<div class="home-head-title">
								<h2 id="miembros">{heading}</h2>
							</div>
							<p class="home-lead">
								{onlineSentence} Las etiquetas marcan a quien lleva el servidor, a quien está en sus <a href="/blog/como-evitar-expulsion-inactividad/">dos semanas de prueba</a> y a quien ha avisado de que estará fuera una temporada.
							</p>
						</div>

						<ul class="members-grid">
							{members.map((member) => (
								<li class:list={['member', { 'member-away': member.status === 'absence' }]}>
									<img class="member-head" src={`/api/cabeza/${encodeURIComponent(member.name)}.png`} alt="" width="8" height="8" decoding="async" />
									<p class="member-name">{member.name}</p>
									{member.joinedAt && <p class="member-since">Desde {monthFormat.format(member.joinedAt)}</p>}
									{(member.role || (onlineFresh && member.online) || member.status !== 'member') && (
										<p class="member-tags">
											{member.role && <span class="member-tag member-tag-staff">{roleLabels[member.role]}</span>}
											{onlineFresh && member.online && <span class="member-tag member-tag-online"><span class="member-dot" aria-hidden="true"></span>Jugando</span>}
											{member.status === 'trial' && <span class="member-tag member-tag-trial">En prueba</span>}
											{member.status === 'absence' && <span class="member-tag">Ausente</span>}
										</p>
									)}
								</li>
							))}
						</ul>
					</>
				) : (
					<div class="home-head">
						<div class="home-head-title">
							<h2 id="miembros">La lista no está disponible.</h2>
						</div>
						<p class="home-lead">Ahora mismo no podemos cargarla. Vuelve a probar en un rato.</p>
					</div>
				)}
			</section>

			<CtaBand title={cta.title} lead={cta.lead} secondary={{ href: '/normas/', label: 'Leer las normas' }} />
		</main>

		<SiteFooter />
	</div>
</Layout>
