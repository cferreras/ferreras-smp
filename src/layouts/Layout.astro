---
import "../styles/global.css";
import type { AnalyticsProvider } from "../lib/analytics";
import { server } from "../data/server";

interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  analyticsPage?: "join-guide" | "blog-post";
  analyticsContentId?: string;
  ogType?: "website" | "article";
  socialImage?: string;
  socialImageAlt?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  noindex?: boolean;
  includeCanonical?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  pageType?: "WebPage" | "CollectionPage";
}

const {
  title,
  description,
  structuredData: pageStructuredData,
  analyticsPage,
  analyticsContentId,
  ogType = "website",
  socialImage = "/images/og-ferreras-smp.jpg",
  socialImageAlt = "Ferreras SMP, supervivencia a tu ritmo",
  publishedTime,
  modifiedTime,
  author,
  breadcrumbs = [],
  pageType = "WebPage",
  noindex = false,
  includeCanonical = true,
} = Astro.props;
const requestedAnalyticsProvider = import.meta.env.PUBLIC_ANALYTICS_PROVIDER;
const plausibleScriptUrl = import.meta.env.PUBLIC_PLAUSIBLE_SCRIPT_URL;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const analyticsProvider: AnalyticsProvider =
  requestedAnalyticsProvider === "plausible" && plausibleScriptUrl
    ? "plausible"
    : requestedAnalyticsProvider === "ga4" && gaMeasurementId
      ? "ga4"
      : "none";
const siteUrl = Astro.site ?? new URL("https://mc.ferreras.dev");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const socialImageUrl = new URL(socialImage, siteUrl);
const organizationId = new URL("/#organization", siteUrl).href;
const websiteId = new URL("/#website", siteUrl).href;
const webPageId = `${canonicalUrl.href}#webpage`;
const breadcrumbId = `${canonicalUrl.href}#breadcrumb`;
const structuredData: {
  "@context": string;
  "@graph": Record<string, unknown>[];
} = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organizationId,
      name: "Ferreras SMP",
      url: siteUrl.href,
      description: server.description,
      logo: new URL("/images/brand/ferreras-smp-icon-512.png", siteUrl).href,
      sameAs: [server.discord],
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: siteUrl.href,
      name: "Ferreras SMP",
      description: server.description,
      inLanguage: "es",
      publisher: { "@id": organizationId },
    },
    ...(!noindex ? [{
      "@type": pageType,
      "@id": webPageId,
      url: canonicalUrl.href,
      name: title,
      description,
      inLanguage: "es",
      isPartOf: { "@id": websiteId },
      publisher: { "@id": organizationId },
      ...(breadcrumbs.length > 1 ? { breadcrumb: { "@id": breadcrumbId } } : {}),
    }] : []),
    ...(breadcrumbs.length > 1 ? [{
      "@type": "BreadcrumbList",
      "@id": breadcrumbId,
      itemListElement: breadcrumbs.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.label,
        item: new URL(item.href, siteUrl).href,
      })),
    }] : []),
  ],
};

const pageSchemas = pageStructuredData
  ? Array.isArray(pageStructuredData) ? pageStructuredData : [pageStructuredData]
  : [];

structuredData["@graph"].push(...pageSchemas);
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {includeCanonical && <link rel="canonical" href={canonicalUrl} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/brand/ferreras-smp-icon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/brand/ferreras-smp-icon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/brand/ferreras-smp-icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Ferreras SMP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    {ogType === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === "article" && author && <meta property="article:author" content={author} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="alternate" type="application/rss+xml" title="Blog de Ferreras SMP" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    {analyticsProvider === "plausible" && (
      <>
        <script
          is:inline
          defer
          data-domain={siteUrl.hostname}
          src={plausibleScriptUrl}
        ></script>
        <script
          is:inline
          set:html={'window.plausible=window.plausible||function(){(window.plausible.q=window.plausible.q||[]).push(arguments)};'}
        />
      </>
    )}
    {analyticsProvider === "ga4" && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaMeasurementId)}`}></script>
        <script
          is:inline
          set:html={`window.dataLayer=window.dataLayer||[];window.gtag=function(){window.dataLayer.push(arguments)};window.gtag('js',new Date());window.gtag('config',${JSON.stringify(gaMeasurementId)},{send_page_view:true});`}
        />
      </>
    )}
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("ferreras-theme");
        const theme = saved === "light" || saved === "dark"
          ? saved
          : matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <title>{title}</title>
  </head>
  <body
    data-analytics-provider={analyticsProvider}
    data-analytics-page={analyticsPage}
    data-analytics-content-id={analyticsContentId}
  >
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <div class="site-frame">
      <slot />
    </div>
    <script>
      import "../scripts/analytics";
    </script>
  </body>
</html>
