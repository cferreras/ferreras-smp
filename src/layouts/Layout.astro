---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	imageAlt?: string;
	type?: 'website' | 'article';
	author?: string;
	section?: string;
	tags?: string[];
	publishedAt?: Date;
	updatedAt?: Date;
	structuredData?: Record<string, unknown>[];
	noindex?: boolean;
}

const {
	title = 'Cubusfera — Minecraft Vanilla técnico, hecho en comunidad',
	description = 'Cubusfera es un servidor Minecraft Java 26.2, Vanilla técnico y comunitario. Una microcomunidad pequeña, sin Pay2Win y sin modpack obligatorio.',
	image = '/images/og-cubusfera.jpg',
	imageAlt = 'Cubusfera, servidor de Minecraft Vanilla técnico hecho en comunidad',
	type = 'website',
	author,
	section,
	tags = [],
	publishedAt,
	updatedAt,
	structuredData = [],
	noindex = false,
} = Astro.props;

const brandIcon = '/images/brand/cubusfera-icon-512.png';
const siteUrl = Astro.site ?? new URL('https://cubusfera.com');
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const imageUrl = new URL(image, siteUrl).toString();
const commonSchema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': 'https://cubusfera.com/#organization',
			name: 'Cubusfera',
			url: 'https://cubusfera.com/',
			logo: {
				'@type': 'ImageObject',
				url: new URL(brandIcon, siteUrl).toString(),
				width: 512,
				height: 512,
			},
			description: 'Servidor de Minecraft Java Vanilla técnico y comunitario con whitelist.',
			sameAs: ['https://discord.com/invite/xW7yyHRJvE'],
		},
		{
			'@type': 'WebSite',
			'@id': 'https://cubusfera.com/#website',
			url: 'https://cubusfera.com/',
			name: 'Cubusfera',
			inLanguage: 'es-ES',
			publisher: { '@id': 'https://cubusfera.com/#organization' },
		},
	],
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#7c3aed" />
		<meta name="description" content={description} />
		{/* Las páginas de utilidad (estado, BlueMap) se marcan con noindex: siguen
		    siendo útiles para quien navega, pero no aportan contenido suficiente
		    para el índice y arrastran la calidad percibida del dominio. */}
		<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
		{author && <meta name="author" content={author} />}
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonical} />
		{/* El .ico va primero como respaldo para Safari y el rastreador de favicons
		    de Google, que prefiere ICO o PNG. El favicon abre más los huecos de la
		    "Y" que el isotipo de la navbar para que se siga leyendo a 16 px. */}
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/svg+xml" href="/images/brand/cubusfera-favicon.svg" />
		{/* iOS compone el icono sobre negro y no respeta la transparencia, así que
		    el touch icon va a sangre sobre el violeta de marca. */}
		<link rel="apple-touch-icon" sizes="180x180" href="/images/brand/cubusfera-apple-touch-180.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="Cubusfera" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:alt" content={imageAlt} />
		<meta property="og:url" content={canonical} />
		{type === 'article' && publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
		{type === 'article' && updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
		{type === 'article' && author && <meta property="article:author" content={author} />}
		{type === 'article' && section && <meta property="article:section" content={section} />}
		{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<meta name="twitter:image:alt" content={imageAlt} />
		<script type="application/ld+json" set:html={JSON.stringify(commonSchema)} />
		{structuredData.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
		<title>{title}</title>
		<script is:inline src="/theme-init.js"></script>
	</head>
	<body>
		<slot />
		<script is:inline src="/theme-toggle.js"></script>
	</body>
</html>
