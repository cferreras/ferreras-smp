---
import BrandWordmark from './BrandWordmark.astro';
import DiscordIcon from './DiscordIcon.astro';
import ThemeIcon from './ThemeIcon.astro';

interface Props {
	// `video`: la banda es el hero a pantalla completa de la portada, con la
	// foto de fondo (el nombre viene del vídeo que llevaba antes); `band`: la
	// banda verde de las páginas interiores.
	variant?: 'band' | 'video';
}

const { variant = 'band' } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const discordUrl = 'https://discord.com/invite/xW7yyHRJvE';
const links = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Servidor', href: '/servidor/' },
	{ label: 'Cómo entrar', href: '/como-entrar/' },
	{ label: 'Normas', href: '/normas/' },
	{ label: 'Blog', href: '/blog/' },
];

const themeOptions = [
	{ value: 'system', label: 'Sistema' },
	{ value: 'light', label: 'Claro' },
	{ value: 'dark', label: 'Oscuro' },
] as const;

const isCurrent =(href: string) => {
	const normalized = href.replace(/\/$/, '') || '/';
	return normalized === '/' ? currentPath === '/' : currentPath.startsWith(normalized);
};
---

{/* La navegación flota fija sobre la página: transparente encima de la banda y
    cápsula oscura translúcida en cuanto se hace scroll (site-nav.js). Va fuera
    de la banda para que el hero de la portada pueda quedarse pegado debajo. */}
<header class="site-nav" data-site-nav>
	<div class="topbar">
		<a class="brand" href="/" aria-label="Cubusfera, inicio">
			<BrandWordmark class="brand-wordmark" />
		</a>

		<nav class="desktop-nav" aria-label="Navegación principal">
			{links.map((link) => (
				<a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
			))}
		</nav>

		<div class="theme-menu" data-theme-menu>
			<button
				class="theme-toggle"
				data-theme-toggle
				type="button"
				aria-haspopup="menu"
				aria-expanded="false"
				aria-controls="theme-menu-panel"
			>
				<ThemeIcon />
				<span data-theme-label>Tema</span>
			</button>
			<div class="theme-menu-panel" id="theme-menu-panel" role="menu" aria-label="Tema" hidden>
				{themeOptions.map((option) => (
					<button class="theme-menu-option" type="button" role="menuitemradio" aria-checked="false" data-theme-option={option.value} tabindex="-1">
						<ThemeIcon variant={option.value} />
						<span>{option.label}</span>
					</button>
				))}
			</div>
		</div>

		<a class="header-cta" href={discordUrl} target="_blank" rel="noopener noreferrer">Discord</a>

		<details class="mobile-menu">
			<summary aria-label="Abrir menú">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
			</summary>
			<nav class="mobile-menu-panel" aria-label="Navegación móvil">
				{links.map((link) => (
					<a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
				))}
				<a class="header-cta" href={discordUrl} target="_blank" rel="noopener noreferrer"><DiscordIcon /> <span>Entrar en Discord</span></a>
			</nav>
		</details>
	</div>
</header>

{/* La banda recibe la entradilla de la página por el slot. */}
<div class:list={['topband', { 'topband-video': variant === 'video' }]}>
	<slot />
</div>

{/* Aparece cuando la primera pantalla ha quedado atrás (lo gestiona back-to-top.js). */}
<button class="back-to-top" type="button" data-back-to-top aria-label="Volver arriba">
	<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5.5 11.5 12 5l6.5 6.5" /></svg>
</button>
