---
import type { MinecraftStatus } from "../types/minecraft-live";

interface Props { status: MinecraftStatus; }

const { status } = Astro.props;
const statusLabel = status.online ? "Online" : "Offline";
const statusClass = status.online ? "online" : "offline";
const metrics = [
  { label: "Jugadores", value: `${status.playersOnline} / ${status.maxPlayers}` },
  { label: "Día del mundo", value: status.worldDay === null ? "No disponible" : status.worldDay.toString() },
  { label: "TPS", value: status.tps === null ? "No disponible" : status.tps.toFixed(1) },
];
---

<article class="live-card status-card" aria-labelledby="live-status-title">
  <div class="card-heading-row">
    <div>
      <p class="card-kicker">Ferreras SMP ahora</p>
      <h3 id="live-status-title">Servidor en marcha</h3>
    </div>
    <span class:list={["status-badge", statusClass]} aria-label={`Estado: ${statusLabel}`} data-status-badge>
      <span class="status-dot" aria-hidden="true"></span>
      <span data-status-label>{statusLabel}</span>
    </span>
  </div>

  <dl class="status-metrics">
    {metrics.map((metric) => (
      <div>
        <dt>{metric.label}</dt>
        <dd data-status-metric={metric.label}>{metric.value}</dd>
      </div>
    ))}
  </dl>

  <p class="card-meta mono" data-status-updated>Última actualización: hace unos segundos</p>
</article>
