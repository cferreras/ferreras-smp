---
import Icon from "./Icon.astro";
import { server } from "../data/server";

const links = [
  { href: "#directo", label: "Directo" },
  { href: "#servidor", label: "Servidor" },
  { href: "#normas", label: "Normas" },
  { href: "#mods", label: "Mods" },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="wordmark" href="#" aria-label={`${server.name}, inicio`}>
      <span class="wordmark-mark" aria-hidden="true">F</span>
      <span>{server.name}</span>
    </a>

    <nav class="desktop-nav" aria-label="Navegación principal">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a class="nav-cta" href={server.discord} target="_blank" rel="noreferrer">
        Discord <Icon name="arrow" size={16} />
      </a>
    </nav>

    <details class="mobile-nav">
      <summary aria-label="Abrir navegación"><Icon name="menu" /></summary>
      <nav aria-label="Navegación móvil">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
        <a href={server.discord} target="_blank" rel="noreferrer">Discord</a>
      </nav>
    </details>
  </div>
</header>
