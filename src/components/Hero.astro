---
import { Image } from "astro:assets";
import heroCharacters from "../assets/images/hero-characters.webp";
import ServerAddress from "./ServerAddress.astro";
import { server } from "../data/server";
---

<section class="hero" id="contenido">
  <div class="shell hero-layout">
    <div class="hero-copy">
      <h1>Servidor Minecraft survival<br /><em>para jugar a tu ritmo.</em></h1>
      <p class="hero-intro">{server.description}</p>
      <div class="hero-actions">
        <a class="button button-primary" href={server.discord} target="_blank" rel="noreferrer" data-analytics-discord="hero">Entrar al Discord</a>
        <a class="button button-secondary" href="/como-entrar">Cómo entrar</a>
      </div>
    </div>

    <aside class="hero-panel" aria-label="Acceso al servidor">
      <figure class="hero-media">
        <Image
          src={heroCharacters}
          alt="Tres personajes de Minecraft preparados para explorar"
          width="1200"
          height="800"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
      <ServerAddress placement="hero" />
      <div class="hero-note">
        <p>Entra directamente desde Minecraft Java, sin instalar un modpack. Nosotros nos ocupamos de las mejoras técnicas.</p>
      </div>
    </aside>
  </div>
</section>
