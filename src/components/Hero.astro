---
import { Image } from "astro:assets";
import heroCharacters from "../assets/images/hero-characters.webp";
import ServerAddress from "./ServerAddress.astro";
import ServerStatusStrip from "./ServerStatusStrip.astro";
import { server } from "../data/server";
import { DEFAULT_MINECRAFT_SNAPSHOT } from "../lib/minecraft/constants";

const minecraftApiBase = import.meta.env.PUBLIC_MINECRAFT_API_URL || "";
---

<section class="hero">
  <div class="shell hero-layout">
    <div class="hero-copy">
      <h1>Servidor Minecraft survival<br /><em>para jugar a tu ritmo.</em></h1>
      <p class="hero-intro">
        {server.description} Construye granjas y automatizaciones sencillas o de complejidad media en un survival cercano a vanilla.
      </p>
      <div class="hero-actions">
        <a class="button button-secondary" href="/como-entrar">Cómo entrar</a>
        <a class="text-link hero-discord-link" href={server.discord} target="_blank" rel="noreferrer" data-analytics-discord="hero">Discord (opcional) <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <aside class="hero-panel" aria-label="Acceso al servidor">
      <figure class="hero-media">
        <Image
          src={heroCharacters}
          alt="Tres personajes de Minecraft preparados para explorar"
          width="1200"
          height="800"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
      <ServerAddress placement="hero" />
      <div class="hero-note">
        <p>Entra directamente desde Minecraft Java, sin instalar un modpack. Nosotros nos ocupamos de las mejoras técnicas.</p>
      </div>
    </aside>
  </div>
</section>

<section
  class="live-section"
  id="directo"
  data-minecraft-live
  data-minecraft-api-base={minecraftApiBase.replace(/\/$/, "")}
  aria-labelledby="live-section-title"
>
  <div class="shell live-section-shell">
    <ServerStatusStrip
      status={DEFAULT_MINECRAFT_SNAPSHOT.status}
      events={DEFAULT_MINECRAFT_SNAPSHOT.activity}
    />
  </div>
</section>

<script>
  import "../scripts/minecraft-live";
</script>
