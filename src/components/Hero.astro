---
import Icon from "./Icon.astro";
import ServerAddress from "./ServerAddress.astro";
import { server } from "../data/server";
---

<section class="hero" id="contenido">
  <div class="container hero-grid">
    <div class="hero-copy">
      <div class="eyebrow reveal">
        <span class="status-dot" aria-hidden="true"></span>
        Supervivencia · Sin mods requeridos
      </div>
      <h1 class="reveal delay-1">
        Un lugar tranquilo<br />
        <span>para jugar a tu ritmo.</span>
      </h1>
      <p class="hero-intro reveal delay-2">{server.description}</p>
      <div class="hero-actions reveal delay-3">
        <a class="button primary" href={server.discord} target="_blank" rel="noreferrer">
          <Icon name="discord" /> Entrar al Discord
        </a>
        <a class="text-link" href="#servidor">
          Conocer el servidor <Icon name="arrow" size={17} />
        </a>
      </div>
    </div>

    <div class="hero-side reveal delay-2">
      <div class="hero-note">
        <span>01</span>
        <p>
          Entra directamente desde Minecraft Java. Nosotros nos ocupamos de las
          mejoras técnicas.
        </p>
      </div>
      <ServerAddress />
    </div>
  </div>
  <div class="hero-line" aria-hidden="true"></div>
</section>
