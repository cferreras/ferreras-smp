---
interface Props {
  name: "arrow" | "check" | "copy" | "discord" | "menu";
  size?: number;
}

const { name, size = 20 } = Astro.props;
const paths = {
  arrow: '<path d="M5 12h14m-5-5 5 5-5 5"/>',
  check: '<path d="m5 12 4 4L19 6"/>',
  copy: '<rect x="8" y="8" width="11" height="11" rx="2"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/>',
  discord:
    '<path d="M8.4 8.3a8.7 8.7 0 0 1 7.2 0M9 15.5c2 1.5 4 1.5 6 0"/><path d="M7.2 4.5C3.9 5.5 2.5 8 2 16c2.3 1.8 4.5 2.5 6.7 2.8l1-1.4M16.8 4.5C20.1 5.5 21.5 8 22 16c-2.3 1.8-4.5 2.5-6.7 2.8l-1-1.4"/><circle cx="8.5" cy="12" r=".8" fill="currentColor" stroke="none"/><circle cx="15.5" cy="12" r=".8" fill="currentColor" stroke="none"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
};
---

<svg
  aria-hidden="true"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={paths[name]}
/>
