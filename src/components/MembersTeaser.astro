---
import HomeCommunity from './HomeCommunity.astro';
import { getMembers } from '../lib/members';

// Adelanto de /comunidad/ en la portada. La portada es estática, así que esto va
// como server island (server:defer): se pide aparte y la CDN lo guarda un
// minuto, como la página entera. Si el panel no responde no se pinta la sección.
const { ok, members, onlineFresh } = await getMembers();

Astro.response.headers.set(
	'Cache-Control',
	ok ? 'public, max-age=0, s-maxage=60, stale-while-revalidate=60' : 'public, max-age=0, s-maxage=10',
);

const onlineCount = onlineFresh ? members.filter((member) => member.online).length : 0;
// Sin cupo de miembros: el límite de 20 es de jugadores conectados a la vez.
const label = `${members.length === 1 ? 'persona' : 'personas'} en la whitelist`;

function headLabel(name: string, online: boolean, away: boolean) {
	if (online) return `${name}, jugando ahora`;
	if (away) return `${name}, ausente`;
	return name;
}
---

{ok && members.length > 0 && (
	<HomeCommunity>
		<div class="home-tile home-members">
			<div class="home-members-summary">
				<p class="home-members-count"><strong>{members.length}</strong></p>
				<p class="home-members-label">{label}</p>
				{onlineCount > 0 && <p class="home-members-online"><span class="home-members-dot" aria-hidden="true"></span>{onlineCount} jugando ahora</p>}
				<a class="button" href="/comunidad/">Ver la comunidad</a>
			</div>
			<ul class="home-members-heads">
				{members.map((member) => {
					const online = onlineFresh && member.online;
					const away = member.status === 'absence';
					return (
						<li class:list={['home-members-head', { 'is-online': online, 'is-away': away }]}>
							<img src={`/api/cabeza/${encodeURIComponent(member.name)}.png`} alt={headLabel(member.name, online, away)} width="8" height="8" decoding="async" />
						</li>
					);
				})}
			</ul>
		</div>
	</HomeCommunity>
)}
