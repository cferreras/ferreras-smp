---
import { modGroups } from "../data/server";
---

<section class="section mods" id="mods">
  <div class="container">
    <div class="mods-heading">
      <div>
        <p class="section-kicker">Tecnología</p>
        <h2>Mods del servidor</h2>
      </div>
      <p>
        Mejoras de rendimiento, administración y contenido ejecutadas en el
        servidor. <strong>No necesitas instalar ninguna.</strong>
      </p>
    </div>

    <div class="mod-list">
      {modGroups.map((group, index) => (
        <details class="mod-group" open={index === 0}>
          <summary>
            <span class="mod-index">{String(index + 1).padStart(2, "0")}</span>
            <span class="mod-title">
              <strong>{group.name}</strong>
              <small>{group.description}</small>
            </span>
            <span class="mod-count">{group.mods.length} elementos</span>
            <span class="mod-toggle" aria-hidden="true"></span>
          </summary>
          <ul>
            {group.mods.map((mod) => <li>{mod}</li>)}
          </ul>
        </details>
      ))}
    </div>
  </div>
</section>
