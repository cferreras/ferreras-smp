---
import type { MinecraftActivityEvent } from "../types/minecraft-live";
import { formatRelativeTime } from "../lib/format-relative-time";
import { getVisibleActivityEvents } from "../lib/group-activity-events";

interface Props {
  events: MinecraftActivityEvent[];
}

const { events } = Astro.props;
const groupedEvents = getVisibleActivityEvents(events);
const eventLabels: Record<MinecraftActivityEvent["type"], string> = {
  join: "Entrada",
  leave: "Salida",
  death: "Muerte",
  advancement: "Logro",
  backup: "Backup",
  system: "Sistema",
};
const eventIcons: Record<MinecraftActivityEvent["type"], string> = {
  join: "/icons/house.svg",
  leave: "/icons/house.svg",
  death: "/icons/sword.svg",
  advancement: "/icons/sword.svg",
  backup: "/icons/cube.svg",
  system: "/icons/cube.svg",
};
---

<div class="activity-feed">
  <ul class="activity-list" aria-label="Actividad reciente" data-activity-list hidden={events.length === 0}>
    {groupedEvents.map((event) => (
      <li class="activity-event" data-activity-type={event.type}>
        <span class="activity-icon" aria-hidden="true">
          <img src={eventIcons[event.type]} width="28" height="28" alt="" />
        </span>
        <div class="activity-copy">
          <div class="activity-meta">
            <span class="activity-type">{eventLabels[event.type]}</span>
            <time datetime={event.createdAt}>{formatRelativeTime(event.createdAt)}</time>
          </div>
          <p>
            <span>{event.message}</span>
            {event.count > 1 && <strong class="activity-count" aria-label={`${event.count} veces`}>x{event.count}</strong>}
          </p>
        </div>
      </li>
    ))}
  </ul>
  <p class="empty-live-message activity-empty" data-empty-activity hidden={events.length > 0}>Aún no hay actividad reciente.</p>
</div>
