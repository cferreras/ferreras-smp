---
import { getPlayerAvatarUrl, STEVE_AVATAR_URL } from "../lib/minecraft/avatar";

interface Props { players: string[]; }
const { players } = Astro.props;
---

<article class="live-card online-players" aria-labelledby="online-players-title">
  <div class="card-heading-row">
    <div>
      <p class="card-kicker">Jugadores conectados</p>
      <h3 id="online-players-title" data-players-heading>{players.length} ahora</h3>
    </div>
  </div>

  <ul class="player-list" aria-label="Jugadores conectados" data-player-list hidden={players.length === 0}>
    {players.map((player) => (
      <li>
        <img
          class="player-avatar"
          src={getPlayerAvatarUrl(player)}
          data-player-avatar
          data-fallback-src={STEVE_AVATAR_URL}
          width="28"
          height="28"
          alt=""
          aria-hidden="true"
        />
        <strong>{player}</strong>
      </li>
    ))}
  </ul>
  <p class="empty-live-message" data-empty-players hidden={players.length > 0}>No hay nadie conectado ahora mismo.</p>
</article>
