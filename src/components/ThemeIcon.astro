---
import { icon } from '@fortawesome/fontawesome-svg-core';
import { faCircleHalfStroke, faMoon, faSun } from '@fortawesome/free-solid-svg-icons';

interface Props {
	/* Sin variante se pintan los tres iconos apilados y el CSS muestra el de la
	   preferencia activa; con variante se pinta solo ese (opciones del menú). */
	variant?: 'light' | 'dark' | 'system';
}

const { variant } = Astro.props;

const definitions = {
	light: { icon: faSun, className: 'theme-icon-sun' },
	dark: { icon: faMoon, className: 'theme-icon-moon' },
	system: { icon: faCircleHalfStroke, className: 'theme-icon-system' },
};

const renderIcon = (key: keyof typeof definitions) =>
	icon(definitions[key].icon, {
		attributes: {
			'aria-hidden': 'true',
			focusable: 'false',
		},
		classes: ['theme-icon', definitions[key].className],
	}).html.join('');
---

{variant ? (
	<Fragment set:html={renderIcon(variant)} />
) : (
	<span class="theme-icon-state" aria-hidden="true">
		<Fragment set:html={renderIcon('light')} />
		<Fragment set:html={renderIcon('dark')} />
		<Fragment set:html={renderIcon('system')} />
	</span>
)}
