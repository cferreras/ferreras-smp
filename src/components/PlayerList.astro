---
import { getPlayerAvatarUrl, STEVE_AVATAR_URL } from "../lib/minecraft/avatar";
import { getRandomEmptyPlayerMessage } from "../lib/empty-player-messages";

interface Props { players: string[]; }
const { players } = Astro.props;
---

<div data-player-feed>
  <ul class="player-list" aria-label="Jugadores conectados" data-player-list hidden={players.length === 0}>
    {players.map((player) => (
      <li>
        <img
          class="player-avatar"
          src={getPlayerAvatarUrl(player)}
          data-player-avatar
          data-fallback-src={STEVE_AVATAR_URL}
          width="28"
          height="28"
          alt=""
          aria-hidden="true"
        />
        <span class="player-presence" aria-hidden="true"></span>
        <span class="player-copy">
          <strong>{player}</strong>
          <small>En el mundo</small>
        </span>
      </li>
    ))}
  </ul>
  <p class="empty-live-message" data-empty-players hidden={players.length > 0}>{getRandomEmptyPlayerMessage()}</p>
</div>
