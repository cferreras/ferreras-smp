---
import PollOption from "./PollOption.astro";
import type { MinecraftPoll } from "../types/minecraft-live";

interface Props { poll: MinecraftPoll; }
const { poll } = Astro.props;
---

<article class="live-card community-poll" aria-labelledby="community-poll-title" data-community-poll>
  <div class="card-heading-row">
    <div>
      <p class="card-kicker">Votación comunitaria</p>
      <h3 id="community-poll-title" data-poll-question>{poll.question}</h3>
      <p class="poll-daily-limit mono">Puedes votar una vez al día.</p>
    </div>
  </div>
  <ul class="poll-list" data-poll-list>
    {poll.options.map((option) => <PollOption option={option} />)}
  </ul>
  <p class="poll-feedback mono" data-poll-feedback aria-live="polite"></p>
</article>
