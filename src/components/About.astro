---
import { Image } from "astro:assets";
import connectedCommunity from "../assets/images/feature-connected-community.webp";
import readyToPlay from "../assets/images/feature-ready-to-play.webp";
import simpleSurvival from "../assets/images/feature-simple-survival.webp";

const features = [
  {
    title: "Supervivencia sencilla",
    text: "Una experiencia reconocible y cercana a vanilla, sin sistemas innecesarios.",
    image: simpleSurvival,
    imageAlt: "Pequeño refugio de supervivencia construido con bloques junto a un árbol y una antorcha",
  },
  {
    title: "Entra sin preparar nada",
    text: "No necesitas instalar mods. Abre Minecraft, añade la IP y empieza a jugar.",
    image: readyToPlay,
    imageAlt: "Camino de bloques que conduce a una puerta abierta con herramientas preparadas",
  },
  {
    title: "Comunidad conectada",
    text: "El chat, los avisos y la ayuda del servidor también están disponibles en Discord.",
    image: connectedCommunity,
    imageAlt: "Tres aventureros de bloques conversando alrededor de una hoguera",
  },
];
---

<section class="section about" id="servidor">
  <div class="shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">El servidor</p>
        <h2>Lo esencial,<br /><span>bien cuidado.</span></h2>
      </div>
      <p>Ferreras SMP busca que jugar sea fácil: un mundo de supervivencia, mejoras discretas del lado servidor y una comunidad con sentido común.</p>
    </div>

    <div class="feature-grid">
      {features.map((feature) => (
        <article class="feature-card">
          <div class="feature-visual">
            <Image
              src={feature.image}
              alt={feature.imageAlt}
              width="960"
              height="400"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div>
            <h3>{feature.title}</h3>
            <p>{feature.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
