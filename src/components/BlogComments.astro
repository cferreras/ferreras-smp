---
import {
  COMMENT_BODY_MAX_LENGTH,
  COMMENT_NICKNAME_MAX_LENGTH,
} from "../lib/comments/constants";
import "../styles/blog-comments.css";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const apiBase = import.meta.env.PUBLIC_COMMENTS_API_URL
  || import.meta.env.PUBLIC_MINECRAFT_API_URL
  || "";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
---

<section
  id="comentarios"
  class="blog-comments"
  aria-labelledby="comments-title"
  data-comments-root
  data-slug={slug}
  data-api-base={apiBase}
  data-turnstile-site-key={turnstileSiteKey}
  data-body-max-length={COMMENT_BODY_MAX_LENGTH}
>
  <header class="comments-heading">
    <div class="comments-folio">
      <p class="mono">Apuntes de la comunidad</p>
      <span aria-hidden="true"></span>
      <p class="mono" data-comments-count>— comentarios</p>
    </div>
    <h2 id="comments-title">¿Qué añadirías o qué mejorarías de esta guía?</h2>
    <p>Tus notas ayudan a mantener esta guía útil y precisa para todos los jugadores.</p>
  </header>

  <form class="comment-form" data-comment-form novalidate>
    <div class="comment-identity">
      <img
        class="comment-viewer-avatar"
        data-comment-viewer-avatar
        src="/images/comment-avatars/steve.png"
        width="80"
        height="80"
        alt=""
        aria-hidden="true"
      />
      <label class="comment-field comment-nickname">
        <span class="mono">Nick <small>(aparece públicamente)</small></span>
        <input
          type="text"
          name="nickname"
          minlength="2"
          maxlength={COMMENT_NICKNAME_MAX_LENGTH}
          autocomplete="nickname"
          placeholder="Tu nick"
          required
        />
        <small>¿No tienes cuenta? No pasa nada: publicas con una identidad anónima.</small>
      </label>
      <p class="comment-identity-label mono">
        Escribir como: <strong data-comment-viewer-label>Anónimo</strong>
      </p>
    </div>

    <label class="comment-field comment-message">
      <span class="sr-only">Comentario</span>
      <textarea
        name="body"
        minlength="2"
        maxlength={COMMENT_BODY_MAX_LENGTH}
        rows="3"
        placeholder="Comparte tu apunte o sugerencia…"
        required
      ></textarea>
      <small class="comment-length mono">
        <output data-comment-length>0</output> / {COMMENT_BODY_MAX_LENGTH}
      </small>
    </label>

    <label class="comment-honeypot" aria-hidden="true">
      Sitio web
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>

    <div class="comment-form-footer">
      <div class="comment-guidance">
        <p>Publica con respeto. No compartas datos personales.</p>
        <a href="/normas">Ver normas de la comunidad</a>
      </div>
      {turnstileSiteKey && (
        <div
          class="cf-turnstile"
          data-sitekey={turnstileSiteKey}
          data-theme="dark"
          data-appearance="interaction-only"
          data-action="blog-comment"
        ></div>
      )}
      <button class="comment-submit" type="submit" disabled>
        Añadir a la conversación
      </button>
    </div>

    <p class="comment-form-status" data-comment-form-status aria-live="polite"></p>
  </form>

  <div class="comments-stream">
    <div class="comments-loading" data-comments-loading>
      <span></span><span></span><span></span>
      <p>Abriendo la conversación…</p>
    </div>
    <ol class="comments-list" data-comments-list aria-live="polite"></ol>
    <p class="comments-end mono" data-comments-end hidden>No hay más comentarios.</p>
    <div class="comments-empty" data-comments-empty hidden>
      <p class="mono">Todavía no hay apuntes</p>
      <p>Puedes ser la primera persona en añadir algo a esta guía.</p>
    </div>
    <div class="comments-unavailable" data-comments-unavailable hidden>
      <div>
        <p class="mono">Conversación en pausa</p>
        <p>No hemos podido cargar los comentarios en este momento.</p>
      </div>
      <button type="button" data-comments-retry>Reintentar</button>
    </div>
    <button class="comments-more" type="button" data-comments-more hidden>
      Cargar más comentarios
    </button>
  </div>
</section>

{turnstileSiteKey && (
  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer
  ></script>
)}

<script>
  interface CommentItem {
    id: string;
    authorCode: string;
    avatar: string;
    nickname: string;
    body: string;
    createdAt: string;
    editedAt: string;
    reportCount: number;
    canDelete: boolean;
  }

  interface CommentsResponse {
    ok: boolean;
    error?: string;
    comments?: CommentItem[];
    comment?: CommentItem;
    count?: number;
    nextCursor?: string | null;
    message?: string;
    viewer?: { authorCode: string; avatar: string };
  }

  interface TurnstileWindow extends Window {
    turnstile?: { reset: (element?: Element) => void };
  }

  const skinNames: Record<string, string> = {
    steve: "Steve",
    alex: "Alex",
    noor: "Noor",
    sunny: "Sunny",
    ari: "Ari",
    zuri: "Zuri",
    makena: "Makena",
    kai: "Kai",
    efe: "Efe",
  };
  const getAvatarSkin = (skin: string) => skin in skinNames ? skin : "steve";
  const getAvatarUrl = (skin: string) =>
    `/images/comment-avatars/${getAvatarSkin(skin)}.png`;

  const makeElement = <K extends keyof HTMLElementTagNameMap>(
    tag: K,
    className?: string,
    text?: string,
  ) => {
    const element = document.createElement(tag);
    if (className) element.className = className;
    if (text !== undefined) element.textContent = text;
    return element;
  };

  const makeAvatar = (skin: string) => {
    const safeSkin = getAvatarSkin(skin);
    const avatar = makeElement("img", "comment-avatar");
    avatar.src = getAvatarUrl(safeSkin);
    avatar.width = 48;
    avatar.height = 48;
    avatar.alt = "";
    avatar.title = `Avatar de ${skinNames[safeSkin]}`;
    avatar.setAttribute("aria-hidden", "true");
    return avatar;
  };

  const makeIdempotencyKey = () => {
    if (crypto.randomUUID) return crypto.randomUUID().replaceAll("-", "");
    return Array.from(
      crypto.getRandomValues(new Uint8Array(16)),
      (value) => value.toString(16).padStart(2, "0"),
    ).join("");
  };

  document.querySelectorAll<HTMLElement>("[data-comments-root]").forEach((root) => {
    const slug = root.dataset.slug;
    const apiBase = root.dataset.apiBase?.replace(/\/$/, "") || "";
    const siteKey = root.dataset.turnstileSiteKey;
    const bodyMaxLength = Number.parseInt(root.dataset.bodyMaxLength || "1200", 10);
    const form = root.querySelector<HTMLFormElement>("[data-comment-form]");
    const list = root.querySelector<HTMLOListElement>("[data-comments-list]");
    const loading = root.querySelector<HTMLElement>("[data-comments-loading]");
    const empty = root.querySelector<HTMLElement>("[data-comments-empty]");
    const unavailable = root.querySelector<HTMLElement>("[data-comments-unavailable]");
    const more = root.querySelector<HTMLButtonElement>("[data-comments-more]");
    const end = root.querySelector<HTMLElement>("[data-comments-end]");
    const retry = root.querySelector<HTMLButtonElement>("[data-comments-retry]");
    const submit = root.querySelector<HTMLButtonElement>("[type='submit']");
    const status = root.querySelector<HTMLElement>("[data-comment-form-status]");
    const body = form?.elements.namedItem("body") as HTMLTextAreaElement | null;
    const length = root.querySelector<HTMLOutputElement>("[data-comment-length]");
    const countLabel = root.querySelector<HTMLElement>("[data-comments-count]");
    const viewerAvatar = root.querySelector<HTMLImageElement>("[data-comment-viewer-avatar]");
    const viewerLabel = root.querySelector<HTMLElement>("[data-comment-viewer-label]");
    let cursor: string | null = null;
    let count = 0;
    let submissionIdempotencyKey = makeIdempotencyKey();

    if (!slug || !form || !list || !submit) return;
    const endpoint = `${apiBase}/api/comments/${encodeURIComponent(slug)}`;
    const previewMode = import.meta.env.DEV
      && new URL(window.location.href).searchParams.get("comments-preview") === "1";
    const previewComments: CommentItem[] = [
      {
        id: "preview-1",
        authorCode: "A7F3C",
        avatar: "alex",
        nickname: "AlexMiner",
        body: "Funciona todo perfecto siguiendo la guía. Solo añadiría un paso para comprobar que el firewall no bloquee la conexión al entrar por primera vez.",
        createdAt: "2026-07-26T17:42:00.000Z",
        editedAt: "2026-07-26T18:03:00.000Z",
        reportCount: 0,
        canDelete: false,
      },
      {
        id: "preview-2",
        authorCode: "D3C97",
        avatar: "kai",
        nickname: "Ferreras",
        body: "Buen apunte, AlexMiner. Lo añadiremos a la sección de resolución de problemas. Gracias por ayudar a mejorar la guía.",
        createdAt: "2026-07-26T18:05:00.000Z",
        editedAt: "",
        reportCount: 0,
        canDelete: false,
      },
      {
        id: "preview-3",
        authorCode: "B9D8F",
        avatar: "steve",
        nickname: "Redstone99",
        body: "¿Hay algún límite recomendado de jugadores simultáneos para mantener una experiencia estable?",
        createdAt: "2026-07-27T09:11:00.000Z",
        editedAt: "",
        reportCount: 0,
        canDelete: false,
      },
    ];

    const setCount = (value: number) => {
      count = value;
      if (countLabel) {
        countLabel.textContent = `${value} ${value === 1 ? "comentario" : "comentarios"}`;
      }
    };

    const setViewer = (viewer?: CommentsResponse["viewer"]) => {
      if (!viewer) return;
      if (viewerAvatar) viewerAvatar.src = getAvatarUrl(viewer.avatar);
      if (viewerLabel) viewerLabel.textContent = `Anónimo · ${viewer.authorCode}`;
    };

    const renumberComments = () => {
      Array.from(list.children).forEach((child, index) => {
        const marker = child.querySelector<HTMLElement>(".comment-index");
        if (marker) marker.textContent = String(index + 1).padStart(2, "0");
      });
    };

    const reportComment = async (button: HTMLButtonElement, id: string) => {
      button.disabled = true;
      button.textContent = "Enviando…";
      try {
        const response = await fetch(
          `${apiBase}/api/comments/${encodeURIComponent(id)}/report`,
          { method: "POST", credentials: "include" },
        );
        const result = await response.json() as CommentsResponse;
        button.textContent = response.ok ? "Denunciado" : (result.error || "Reintentar");
      } catch {
        button.disabled = false;
        button.textContent = "Denunciar";
      }
    };

    const deleteComment = async (
      button: HTMLButtonElement,
      item: HTMLLIElement,
      id: string,
    ) => {
      if (!window.confirm("¿Eliminar este comentario? No se puede deshacer.")) return;
      button.disabled = true;
      button.textContent = "Eliminando…";

      try {
        const response = await fetch(
          `${apiBase}/api/comments/own/${encodeURIComponent(id)}`,
          { method: "DELETE", credentials: "include" },
        );
        const result = await response.json() as CommentsResponse;
        if (!response.ok || !result.ok) {
          throw new Error(result.error || "No se pudo eliminar el comentario.");
        }

        item.remove();
        setCount(Math.max(0, count - 1));
        renumberComments();
        if (empty) empty.hidden = list.children.length > 0;
        if (end) end.hidden = list.children.length === 0;
      } catch (error) {
        button.disabled = false;
        button.textContent = "Eliminar";
        if (status) {
          status.textContent = error instanceof Error
            ? error.message
            : "No se pudo eliminar el comentario.";
        }
      }
    };

    const editComment = (
      item: HTMLLIElement,
      comment: CommentItem,
      message: HTMLParagraphElement,
      actions: HTMLDivElement,
    ) => {
      if (item.querySelector(".comment-editor")) return;

      const editor = makeElement("form", "comment-editor");
      const textarea = makeElement("textarea", "comment-edit-textarea");
      textarea.value = comment.body;
      textarea.rows = 4;
      textarea.minLength = 2;
      textarea.maxLength = bodyMaxLength;
      textarea.required = true;
      textarea.setAttribute("aria-label", "Editar comentario");

      const editorActions = makeElement("div", "comment-editor-actions");
      const cancel = makeElement("button", "comment-action", "Cancelar");
      cancel.type = "button";
      const save = makeElement("button", "comment-action comment-action-save", "Guardar");
      save.type = "submit";
      editorActions.append(cancel, save);
      editor.append(textarea, editorActions);

      const closeEditor = () => {
        editor.remove();
        message.hidden = false;
        actions.hidden = false;
      };

      cancel.addEventListener("click", closeEditor);
      editor.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!editor.reportValidity()) return;
        save.disabled = true;
        cancel.disabled = true;
        save.textContent = "Guardando…";

        try {
          const response = await fetch(
            `${apiBase}/api/comments/own/${encodeURIComponent(comment.id)}`,
            {
              method: "PATCH",
              credentials: "include",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ body: textarea.value }),
            },
          );
          const result = await response.json() as CommentsResponse;
          if (!response.ok || !result.ok) {
            throw new Error(result.error || "No se pudo editar el comentario.");
          }

          if (!result.comment) {
            item.remove();
            setCount(Math.max(0, count - 1));
            renumberComments();
            if (empty) empty.hidden = list.children.length > 0;
            if (end) end.hidden = list.children.length === 0;
            if (status) status.textContent = result.message || "Cambio pendiente de revisión.";
            return;
          }

          comment.body = result.comment.body;
          comment.editedAt = result.comment.editedAt;
          message.textContent = comment.body;
          const meta = item.querySelector(".comment-meta");
          if (meta && !meta.querySelector(".comment-edited")) {
            meta.append(makeElement("span", "comment-edited", "editado"));
          }
          closeEditor();
        } catch (error) {
          save.disabled = false;
          cancel.disabled = false;
          save.textContent = "Guardar";
          if (status) {
            status.textContent = error instanceof Error
              ? error.message
              : "No se pudo editar el comentario.";
          }
        }
      });

      message.hidden = true;
      actions.hidden = true;
      message.insertAdjacentElement("afterend", editor);
      textarea.focus();
      textarea.setSelectionRange(textarea.value.length, textarea.value.length);
    };

    const renderComment = (comment: CommentItem) => {
      const item = makeElement("li", "comment-item");
      const index = makeElement(
        "span",
        "comment-index mono",
        String(list.children.length + 1).padStart(2, "0"),
      );
      const content = makeElement("div", "comment-content");
      const header = makeElement("header");
      const byline = makeElement("p", "comment-byline");
      const prefix = makeElement("span", "comment-author-prefix mono", "Nick:");
      const nickname = makeElement("strong", "", comment.nickname);
      const code = makeElement("span", "mono comment-code", comment.authorCode);
      const meta = makeElement("div", "comment-meta");
      const time = makeElement("time");
      time.dateTime = comment.createdAt;
      time.textContent = new Intl.DateTimeFormat("es-ES", {
        day: "numeric",
        month: "short",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
      }).format(new Date(comment.createdAt));

      byline.append(prefix, nickname, code);
      meta.append(time);
      if (comment.editedAt) {
        meta.append(makeElement("span", "comment-edited", "editado"));
      }
      header.append(byline, meta);

      const message = makeElement("p", "comment-body", comment.body);
      const actions = makeElement("div", "comment-actions");

      if (comment.canDelete) {
        const edit = makeElement("button", "comment-action", "Editar");
        edit.type = "button";
        edit.addEventListener(
          "click",
          () => editComment(item, comment, message, actions),
        );
        const remove = makeElement(
          "button",
          "comment-action comment-action-delete",
          "Eliminar",
        );
        remove.type = "button";
        remove.addEventListener(
          "click",
          () => void deleteComment(remove, item, comment.id),
        );
        actions.append(edit, remove);
      } else {
        const report = makeElement("button", "comment-action comment-action-delete", "Denunciar");
        report.type = "button";
        report.addEventListener("click", () => void reportComment(report, comment.id));
        actions.append(report);
      }

      content.append(header, message, actions);
      item.append(index, makeAvatar(comment.avatar), content);
      list.append(item);
    };

    const loadComments = async (append = false) => {
      if (more) more.disabled = true;
      if (!append) {
        if (loading) loading.hidden = false;
        if (unavailable) unavailable.hidden = true;
      }

      if (previewMode) {
        list.replaceChildren();
        previewComments.forEach(renderComment);
        cursor = null;
        setCount(previewComments.length);
        setViewer({ authorCode: "A7F3C", avatar: "alex" });
        if (empty) empty.hidden = true;
        if (end) end.hidden = false;
        if (unavailable) unavailable.hidden = true;
        if (loading) loading.hidden = true;
        if (more) more.hidden = true;
        submit.disabled = false;
        return;
      }

      try {
        const url = new URL(endpoint, window.location.href);
        if (append && cursor) url.searchParams.set("cursor", cursor);
        const response = await fetch(url, { credentials: "include" });
        const result = await response.json() as CommentsResponse;
        if (!response.ok || !result.ok) throw new Error();

        if (!append) list.replaceChildren();
        (result.comments || []).forEach(renderComment);
        cursor = result.nextCursor || null;
        setCount(result.count || 0);
        setViewer(result.viewer);
        if (empty) empty.hidden = list.children.length > 0;
        if (end) end.hidden = Boolean(cursor) || list.children.length === 0;
        if (unavailable) unavailable.hidden = true;
        if (more) {
          more.hidden = !cursor;
          more.disabled = false;
        }
        submit.disabled = !siteKey;
      } catch {
        if (!append) {
          setCount(0);
          if (unavailable) unavailable.hidden = false;
          if (empty) empty.hidden = true;
          if (end) end.hidden = true;
        } else if (more) {
          more.disabled = false;
        }
      } finally {
        if (loading) loading.hidden = true;
      }
    };

    body?.addEventListener("input", () => {
      if (length) length.value = String([...body.value].length);
    });
    more?.addEventListener("click", () => void loadComments(true));
    retry?.addEventListener("click", () => void loadComments());

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const turnstileToken = String(data.get("cf-turnstile-response") || "");
      if (!turnstileToken) {
        if (status) status.textContent = "Completa la comprobación anti-spam.";
        return;
      }

      submit.disabled = true;
      if (status) status.textContent = "Publicando…";
      let responseConfirmed = false;

      try {
        const response = await fetch(endpoint, {
          method: "POST",
          credentials: "include",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            nickname: data.get("nickname"),
            body: data.get("body"),
            website: data.get("website"),
            turnstileToken,
            idempotencyKey: submissionIdempotencyKey,
          }),
        });
        const result = await response.json() as CommentsResponse;
        responseConfirmed = true;
        if (!response.ok || !result.ok) {
          throw new Error(result.error || "No se pudo publicar el comentario.");
        }

        if (result.comment) {
          renderComment(result.comment);
          setCount(count + 1);
          if (empty) empty.hidden = true;
          if (end && !cursor) end.hidden = false;
        }
        setViewer(result.viewer);
        if (status) status.textContent = result.message || "Comentario recibido.";
        if (body) body.value = "";
        if (length) length.value = "0";
      } catch (error) {
        if (status) {
          status.textContent = error instanceof Error
            ? error.message
            : "No se pudo publicar el comentario.";
        }
      } finally {
        if (responseConfirmed) submissionIdempotencyKey = makeIdempotencyKey();
        submit.disabled = false;
        const turnstile = (window as TurnstileWindow).turnstile;
        const widget = root.querySelector(".cf-turnstile");
        if (turnstile && widget) turnstile.reset(widget);
      }
    });

    void loadComments();
  });
</script>
