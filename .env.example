# Public runtime configuration. These values are exposed to the browser.
PUBLIC_MINECRAFT_API_URL=https://mc-api.ferreras.dev
PUBLIC_ANALYTICS_PROVIDER=plausible
PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.carlosferreras.com/js/script.hash.outbound-links.pageview-props.tagged-events.js

# Public comments configuration. These values are exposed to the browser.
PUBLIC_COMMENTS_API_URL=https://mc-api.ferreras.dev
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Private comments configuration. Configure only on the Dokploy API service.
COMMENTS_ALLOWED_ORIGIN=https://mc.ferreras.dev
COMMENTS_PUBLIC_API_URL=https://mc-api.ferreras.dev
COMMENTS_IDENTITY_SECRET=replace-with-at-least-32-random-characters
TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret
COMMENTS_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace/me
COMMENTS_BLOCKED_TERMS=
